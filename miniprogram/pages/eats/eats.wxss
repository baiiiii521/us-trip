/* 顶栏下面接一段午夜蓝：搜索框和城市筛选都在这条带子里 */
.band {
  background: var(--night);
  padding: 4rpx 0 24rpx;
  margin-bottom: 20rpx;
}

.search {
  padding: 0 24rpx 18rpx;
}

.search-input {
  height: 80rpx;
  background: var(--night-2);
  border-radius: 999rpx;
  padding: 0 32rpx;
  font-size: 28rpx;
  color: #FFFFFF;
}

.filters {
  width: 100%;
  white-space: nowrap;
}

.filters-inner {
  display: inline-flex;
  gap: 12rpx;
  padding: 0 24rpx;
}

.filter {
  flex: none;
  display: inline-flex;
  align-items: center;
  gap: 10rpx;
  min-height: 64rpx;
  padding: 0 26rpx;
  border-radius: 999rpx;
  background: var(--night-2);
  font-size: 26rpx;
  font-weight: 600;
  color: var(--on-night-2);
}

.filter.on {
  background: #FFFFFF;
  color: var(--ink);
}

.fdot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
}

.count {
  margin: 0 32rpx 16rpx;
  font-size: 24rpx;
  color: var(--muted);
}

.city-head {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin: 30rpx 32rpx 14rpx;
  font-size: 30rpx;
  font-weight: 750;
  color: var(--ink);
}

.city-line {
  width: 40rpx;
  height: 10rpx;
  border-radius: 5rpx;
}

.eat-card {
  margin: 0 24rpx 18rpx;
}

.eat-top {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 16rpx;
}

.eat-name {
  font-size: 32rpx;
  font-weight: 750;
  color: var(--ink);
}

.eat-price {
  flex: none;
  font-size: 26rpx;
  font-weight: 700;
  color: var(--ink-2);
  letter-spacing: 0.06em;
}

.eat-zh {
  margin-top: 2rpx;
  font-size: 24rpx;
  color: var(--muted);
}

.eat-what {
  margin-top: 12rpx;
  font-size: 28rpx;
  line-height: 1.6;
  color: var(--ink-2);
}

.eat-foot {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin-top: 18rpx;
}

.eat-book {
  font-size: 24rpx;
  color: var(--muted);
}

.eat-day {
  font-size: 24rpx;
  font-weight: 700;
  color: var(--ink);
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
  box-shadow: inset 0 0 0 2rpx var(--line);
  font-variant-numeric: tabular-nums;
}

.eat-nav {
  margin-left: auto;
  min-height: 64rpx;
  padding: 0 30rpx;
  display: flex;
  align-items: center;
  border-radius: 999rpx;
  background: var(--go);
  color: var(--go-ink);
  font-size: 25rpx;
  font-weight: 700;
}

.eat-nav:active {
  background: var(--go-press);
}

.foot-note {
  margin: 24rpx 36rpx 0;
  font-size: 24rpx;
  line-height: 1.6;
  color: var(--muted);
}
