.filters {
  width: 100%;
  white-space: nowrap;
  margin-bottom: 12rpx;
}

.filters-inner {
  display: inline-flex;
  gap: 12rpx;
}

.filter {
  flex: none;
  padding: 10rpx 22rpx;
  border-radius: 28rpx;
  background: #FFFFFF;
  border: 1rpx solid rgba(22, 32, 43, 0.12);
  font-size: 28rpx;
  color: #33404C;
}

.filter.on {
  background: #C04A0A;
  border-color: #C04A0A;
  color: #FFFFFF;
}

.count {
  font-size: 22rpx;
  color: #5E6A76;
  padding: 12rpx 4rpx;
}

.city-head {
  font-size: 24rpx;
  color: #5E6A76;
  letter-spacing: 0.08em;
  padding: 16rpx 4rpx 10rpx;
}

.eat-card {
  padding: 22rpx 24rpx;
}

.eat-top {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}

.eat-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #16202B;
}

.eat-price {
  font-size: 24rpx;
  color: #C04A0A;
}

.eat-zh {
  font-size: 24rpx;
  color: #5E6A76;
  margin-top: 2rpx;
}

.eat-what {
  margin-top: 8rpx;
  font-size: 28rpx;
  color: #33404C;
  line-height: 1.5;
}

.eat-foot {
  margin-top: 12rpx;
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.eat-book {
  font-size: 22rpx;
  color: #5E6A76;
  background: #EEF1F4;
  border-radius: 6rpx;
  padding: 4rpx 10rpx;
}

.eat-day {
  font-size: 22rpx;
  color: #C04A0A;
}

.eat-nav {
  margin-left: auto;
  font-size: 24rpx;
  color: #C04A0A;
  border: 1rpx solid rgba(192, 74, 10, 0.35);
  border-radius: 14rpx;
  padding: 8rpx 20rpx;
}

.eat-nav:active {
  background: rgba(192, 74, 10, 0.08);
}

.foot-note {
  text-align: center;
  font-size: 22rpx;
  color: #A3ADB8;
  padding: 16rpx 0 24rpx;
}
