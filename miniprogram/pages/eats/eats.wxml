<view class="page with-nav">
  <top-bar show-back title="吃什么" sub="按城市分 · 都在步行或地铁范围" />
  <scroll-view class="filters" scroll-x="{{true}}" enhanced="{{true}}" show-scrollbar="{{false}}">
    <view class="filters-inner">
      <view hover-class="press" hover-stay-time="60"
        wx:for="{{cities}}"
        wx:key="key"
        class="filter {{active === item.key ? 'on' : ''}}"
        data-key="{{item.key}}"
        bindtap="pick"
      >{{item.label}}</view>
    </view>
  </scroll-view>

  <view class="count">{{total}} 家 · 营业时间以店里为准</view>

  <view wx:for="{{groups}}" wx:key="city" wx:for-item="g">
    <view class="city-head">{{g.zh}}</view>
    <view class="card eat-card" wx:for="{{g.items}}" wx:key="key" wx:for-item="e">
      <view class="eat-top">
        <text class="eat-name">{{e.name}}</text>
        <text class="eat-price">{{e.price}}</text>
      </view>
      <view class="eat-zh">{{e.zh}}</view>
      <view class="eat-what">{{e.what}}</view>
      <view class="eat-foot">
        <text class="eat-book">{{e.book}}</text>
        <text class="eat-day" wx:if="{{e.day}}">{{e.day}}</text>
        <view hover-class="press" hover-stay-time="60" class="eat-nav" data-key="{{e.key}}" bindtap="nav">导航</view>
      </view>
    </view>
  </view>

  <view class="foot-note">营业时间没逐家核实，出发当天在 Google 地图看一次。</view>
</view>

<bottom-nav current="guide" tripId="{{tripId}}" />
