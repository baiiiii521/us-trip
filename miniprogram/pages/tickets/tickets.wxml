<view class="page-pad">
  <view class="lead">个人小程序不能直接跳外部网站，所以这里统一「复制链接 → 去浏览器粘贴」。所有入口和网站用的是同一份数据。</view>

  <view class="section-label">六场球</view>
  <view class="card game" wx:for="{{games}}" wx:key="id">
    <view class="game-top">
      <view class="game-l">
        <text class="game-title">{{item.title}}</text>
        <text class="game-when">{{item.when}}</text>
      </view>
      <text class="pill {{item.tone === 'warn' ? 'pill-warn' : ''}}">{{item.status}}</text>
    </view>

    <view class="game-meta">
      <text class="game-arena">{{item.arena}}</text>
      <text class="game-price">{{item.price}}</text>
      <text class="game-nav" data-id="{{item.id}}" bindtap="nav">球馆位置</text>
    </view>

    <view class="links">
      <view class="link" wx:for="{{item.links}}" wx:key="label" wx:for-item="l" data-url="{{l.url}}" bindtap="copy">
        {{l.label}}
      </view>
    </view>
  </view>

  <view class="section-label">比价平台</view>
  <view class="card plat" wx:for="{{platforms}}" wx:key="name" data-url="{{item.url}}" bindtap="copy">
    <view class="plat-top">
      <text class="plat-name">{{item.name}}</text>
      <text class="plat-copy">复制链接</text>
    </view>
    <view class="plat-note">{{item.note}}</view>
  </view>

  <view class="section-label">订票与预约入口</view>
  <view class="card vendors">
    <view class="vendor" wx:for="{{vendors}}" wx:key="key" data-url="{{item.url}}" bindtap="copy">
      <text class="vendor-name">{{item.label}}</text>
      <text class="vendor-copy">复制</text>
    </view>
  </view>

  <view class="foot-note">赛程 2026-11-14 按 ESPN 核对过，出发前 48 小时用 NBA App 再看一次有没有改期。</view>
</view>
