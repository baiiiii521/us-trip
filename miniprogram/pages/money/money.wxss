.total-card {
  padding: 28rpx;
}

.total {
  font-size: 60rpx;
  font-weight: 700;
  letter-spacing: -0.02em;
  margin-top: 8rpx;
}

.per {
  margin-top: 6rpx;
  font-size: 24rpx;
  color: var(--muted);
}

.cat {
  padding: 12rpx 0;
}

.cat-top {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}

.cat-name {
  font-size: 28rpx;
  color: var(--ink);
}

.cat-amt {
  font-size: 24rpx;
  color: var(--muted);
}

.bar {
  height: 8rpx;
  background: var(--ground);
  border-radius: 4rpx;
  margin-top: 8rpx;
  overflow: hidden;
}

.bar-fill {
  height: 100%;
  background: var(--night);
  border-radius: 4rpx;
}

.row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
  padding: 12rpx 0;
  border-bottom: 1rpx solid rgba(14, 26, 58, 0.06);
}

.row:last-child {
  border-bottom: none;
}

.row-l {
  flex: 1;
}

.row-label {
  font-size: 28rpx;
  color: var(--ink-2);
  line-height: 1.45;
}

.row-kind {
  display: block;
  font-size: 24rpx;
  color: var(--muted);
  margin-top: 2rpx;
}

.row-amt {
  flex: none;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--ink);
}

.note-card {
  border-style: dashed;
}

.mt {
  margin-top: 18rpx;
}
