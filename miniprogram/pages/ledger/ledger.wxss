.sum {
  padding: 26rpx;
}

.sum-row {
  display: flex;
  justify-content: space-between;
}

.sum-block {
  display: flex;
  flex-direction: column;
}

.sum-block.right {
  align-items: flex-end;
}

.sum-num {
  font-size: 54rpx;
  font-weight: 700;
  letter-spacing: -0.02em;
  margin-top: 4rpx;
}

.sum-num.sm {
  font-size: 40rpx;
  color: #33404C;
}

.settle {
  font-size: 30rpx;
  font-weight: 600;
  color: #C04A0A;
}

.bal {
  display: flex;
  gap: 24rpx;
  margin-top: 14rpx;
}

.bal-item {
  flex: 1;
}

.bal-name {
  font-size: 22rpx;
  color: #5E6A76;
  display: block;
}

.bal-v {
  font-size: 30rpx;
  font-weight: 600;
}

.bal-v.pos { color: #2E7D32; }
.bal-v.neg { color: #B3261E; }

.bal-note {
  display: block;
  font-size: 20rpx;
  color: #A3ADB8;
}

.amount-row {
  display: flex;
  gap: 12rpx;
  align-items: center;
}

.amount {
  flex: 1;
  height: 88rpx;
  font-size: 40rpx;
  font-weight: 600;
  border-bottom: 2rpx solid rgba(22, 32, 43, 0.2);
  padding: 0 8rpx;
}

.pick {
  font-size: 25rpx;
  color: #33404C;
  background: #EEF1F4;
  border-radius: 12rpx;
  padding: 14rpx 18rpx;
  white-space: nowrap;
}

.pickers {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 20rpx;
}

.note-row {
  display: flex;
  gap: 12rpx;
  margin-top: 16rpx;
  align-items: center;
}

.note {
  flex: 1;
  height: 72rpx;
  font-size: 26rpx;
  background: #EEF1F4;
  border-radius: 12rpx;
  padding: 0 18rpx;
}

.pick.date {
  font-variant-numeric: tabular-nums;
}

.add {
  margin-top: 24rpx;
}

.rate-note {
  margin-top: 10rpx;
  font-size: 21rpx;
  color: #A3ADB8;
  text-align: center;
}

.row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
  padding: 16rpx 0;
  border-bottom: 1rpx solid rgba(22, 32, 43, 0.07);
}

.row:last-child {
  border-bottom: none;
}

.row-l {
  flex: 1;
  min-width: 0;
}

.row-main {
  font-size: 27rpx;
  color: #16202B;
}

.row-sub {
  display: block;
  font-size: 21rpx;
  color: #A3ADB8;
  margin-top: 2rpx;
}

.row-r {
  flex: none;
  text-align: right;
}

.row-amt {
  font-size: 28rpx;
  font-weight: 600;
}

.row-usd {
  display: block;
  font-size: 20rpx;
  color: #A3ADB8;
}

.row-del {
  display: block;
  font-size: 21rpx;
  color: #B3261E;
  margin-top: 4rpx;
}

.empty {
  text-align: center;
  font-size: 24rpx;
  color: #A3ADB8;
  padding: 40rpx 0;
}
