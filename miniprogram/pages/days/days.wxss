.topbar {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 8rpx 0 20rpx;
}

.chip {
  font-size: 24rpx;
  color: #C04A0A;
  background: rgba(192, 74, 10, 0.1);
  border-radius: 20rpx;
  padding: 10rpx 18rpx;
}

.topbar-note {
  font-size: 22rpx;
  color: #5E6A76;
}

.strip {
  width: 100%;
  white-space: nowrap;
  margin-bottom: 20rpx;
}

.strip-inner {
  display: inline-flex;
  gap: 12rpx;
  padding: 4rpx 0;
}

.strip-item {
  flex: none;
  min-width: 88rpx;
  padding: 12rpx 16rpx;
  border-radius: 16rpx;
  background: #FFFFFF;
  border: 1rpx solid rgba(22, 32, 43, 0.12);
  display: flex;
  flex-direction: column;
  align-items: center;
}

.strip-item.on {
  border-color: #C04A0A;
}

.strip-md {
  font-size: 26rpx;
  font-weight: 600;
  color: #16202B;
}

.strip-wd {
  font-size: 20rpx;
  color: #5E6A76;
}

.day {
  padding: 24rpx;
}

.day-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.day-date {
  display: flex;
  align-items: baseline;
  gap: 10rpx;
}

.day-md {
  font-size: 34rpx;
  font-weight: 700;
}

.day-wd {
  font-size: 24rpx;
  color: #5E6A76;
}

.day-meta {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.day-city {
  font-size: 24rpx;
  color: #33404C;
}

.day-title {
  margin-top: 8rpx;
  font-size: 30rpx;
  font-weight: 600;
  color: #16202B;
}

.tl {
  display: flex;
  gap: 14rpx;
  padding-top: 18rpx;
}

.tl-rail {
  flex: none;
  width: 14rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.tl-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 6rpx;
  background: rgba(22, 32, 43, 0.25);
  margin-top: 12rpx;
}

.tl-dot.game { background: #B3261E; }
.tl-dot.drive { background: #C04A0A; }

.tl-line {
  flex: 1;
  width: 2rpx;
  background: rgba(22, 32, 43, 0.08);
  margin-top: 6rpx;
}

.tl-body {
  flex: 1;
  padding-bottom: 10rpx;
}

.tl-time {
  font-size: 25rpx;
  color: #C04A0A;
  font-weight: 600;
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.tag {
  font-size: 19rpx;
  color: #5E6A76;
  background: #EEF1F4;
  border-radius: 6rpx;
  padding: 2rpx 8rpx;
  font-weight: 400;
}

.tag.game { color: #B3261E; background: rgba(179, 38, 30, 0.08); }
.tag.drive { color: #C04A0A; background: rgba(192, 74, 10, 0.08); }
.tag.leg { color: #1F4E8C; background: rgba(31, 78, 140, 0.08); }
.tag.xmas { color: #8A5A0B; background: rgba(138, 90, 11, 0.1); }

.tl-text {
  margin-top: 4rpx;
  font-size: 27rpx;
  line-height: 1.55;
  color: #33404C;
}

.tl-note {
  margin-top: 6rpx;
  font-size: 25rpx;
  color: #5E6A76;
}

.chips {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 10rpx;
}

.poi-chip {
  font-size: 23rpx;
  color: #1F4E8C;
  border: 1rpx solid rgba(31, 78, 140, 0.28);
  border-radius: 8rpx;
  padding: 4rpx 12rpx;
}

.day-warn {
  margin-top: 12rpx;
  font-size: 25rpx;
  line-height: 1.55;
  color: #8A5A0B;
  background: rgba(138, 90, 11, 0.08);
  border-radius: 12rpx;
  padding: 14rpx;
}

.day-tip {
  margin-top: 8rpx;
  font-size: 24rpx;
  line-height: 1.55;
  color: #5E6A76;
}

.day-stay {
  margin-top: 12rpx;
  padding-top: 12rpx;
  border-top: 1rpx solid rgba(22, 32, 43, 0.08);
  font-size: 24rpx;
  color: #5E6A76;
}

.foot-note {
  text-align: center;
  font-size: 22rpx;
  color: #A3ADB8;
  padding: 8rpx 0 24rpx;
}
