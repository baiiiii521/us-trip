.pad {
  padding: 0 28rpx;
}

/* 进场：一次渐进，不是每块都弹 */
@keyframes rise {
  from { opacity: 0; transform: translateY(20rpx); }
  to { opacity: 1; transform: translateY(0); }
}

.rise {
  animation: rise 420ms cubic-bezier(0.16, 1, 0.3, 1) both;
}

.tap-dim {
  opacity: 0.62;
}

.map-card {
  padding: 0;
  overflow: hidden;
  margin-top: 18rpx;
}

.map-head {
  padding: 24rpx 26rpx 12rpx;
}

.map-title {
  font-size: 30rpx;
  font-weight: 700;
  letter-spacing: -0.01em;
}

.map-sub {
  display: block;
  font-size: 22rpx;
  color: #5E6A76;
  margin-top: 6rpx;
  line-height: 1.5;
}

.map {
  width: 100%;
  height: 340rpx;
}

.map.small {
  height: 280rpx;
  border-radius: 16rpx;
}

.map-foot {
  font-size: 22rpx;
  color: #C04A0A;
  padding: 16rpx 26rpx 18rpx;
  border-top: 1rpx solid rgba(22, 32, 43, 0.06);
}

.strip {
  width: 100%;
  white-space: nowrap;
  margin: 20rpx 0 12rpx;
}

.strip-inner {
  display: inline-flex;
  gap: 10rpx;
  padding: 2rpx 0;
}

.strip-item {
  flex: none;
  min-width: 86rpx;
  padding: 12rpx 14rpx;
  border-radius: 16rpx;
  background: #FFFFFF;
  border: 1rpx solid rgba(22, 32, 43, 0.08);
  display: flex;
  flex-direction: column;
  align-items: center;
  transition: background 180ms ease, border-color 180ms ease;
}

.strip-item.today {
  border-color: rgba(192, 74, 10, 0.45);
}

.strip-item.on {
  background: #C04A0A;
  border-color: #C04A0A;
}

.strip-md {
  font-size: 24rpx;
  font-weight: 600;
  color: #16202B;
  font-variant-numeric: tabular-nums;
}

.strip-wd {
  font-size: 19rpx;
  color: #5E6A76;
  margin-top: 2rpx;
}

.strip-item.on .strip-md,
.strip-item.on .strip-wd {
  color: #FFFFFF;
}

.toolbar {
  display: flex;
  gap: 12rpx;
  margin: 4rpx 0 2rpx;
}

.chip {
  font-size: 22rpx;
  color: #C04A0A;
  background: rgba(192, 74, 10, 0.08);
  border-radius: 999rpx;
  padding: 12rpx 20rpx;
}

.chip.ghost {
  color: #33404C;
  background: rgba(22, 32, 43, 0.05);
  margin-left: auto;
}

.day {
  padding: 26rpx 26rpx 10rpx;
  margin-top: 20rpx;
}

.day-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 12rpx;
}

.day-date {
  display: flex;
  align-items: baseline;
  gap: 14rpx;
  min-width: 0;
}

.day-md {
  font-size: 34rpx;
  font-weight: 700;
  letter-spacing: -0.02em;
  font-variant-numeric: tabular-nums;
}

.day-meta {
  display: flex;
  flex-direction: column;
  gap: 2rpx;
  min-width: 0;
}

.day-wd {
  font-size: 22rpx;
  color: #33404C;
}

.day-weather {
  font-size: 21rpx;
  color: #A3ADB8;
}

.pace-dot {
  flex: none;
  font-size: 21rpx;
  color: #5E6A76;
  background: rgba(22, 32, 43, 0.05);
  border-radius: 999rpx;
  padding: 6rpx 14rpx;
  font-variant-numeric: tabular-nums;
}

.pace-dot.hi { color: #B3261E; background: rgba(179, 38, 30, 0.08); }
.pace-dot.mid { color: #8A5A0B; background: rgba(138, 90, 11, 0.09); }

.day-title {
  margin-top: 12rpx;
  font-size: 30rpx;
  font-weight: 600;
  line-height: 1.45;
  letter-spacing: -0.01em;
}

/* 收起状态的三行 */
.mini {
  display: flex;
  align-items: center;
  gap: 14rpx;
  padding: 14rpx 0;
  border-top: 1rpx solid rgba(22, 32, 43, 0.05);
}

.mini:first-of-type {
  margin-top: 14rpx;
}

.mini-time {
  flex: none;
  width: 118rpx;
  font-size: 22rpx;
  color: #C04A0A;
  font-weight: 600;
  font-variant-numeric: tabular-nums;
}

.mini-text {
  flex: 1;
  font-size: 24rpx;
  color: #33404C;
  line-height: 1.5;
}

.mini-go {
  flex: none;
  font-size: 21rpx;
  color: #C04A0A;
  border: 1rpx solid rgba(192, 74, 10, 0.35);
  border-radius: 999rpx;
  padding: 4rpx 12rpx;
}

.mini-go.poi {
  color: #1F4E8C;
  border-color: rgba(31, 78, 140, 0.28);
}

.more {
  margin-top: 4rpx;
  padding: 20rpx 0;
  text-align: center;
  font-size: 22rpx;
  color: #C04A0A;
  border-top: 1rpx solid rgba(22, 32, 43, 0.06);
}

/* 展开状态的时间轴 */
.tl {
  display: flex;
  gap: 14rpx;
  padding-top: 18rpx;
  animation: rise 300ms cubic-bezier(0.16, 1, 0.3, 1) both;
}

.tl-rail {
  flex: none;
  width: 14rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.tl-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 6rpx;
  background: rgba(22, 32, 43, 0.22);
  margin-top: 12rpx;
}

.tl-dot.game { background: #B3261E; }
.tl-dot.drive { background: #C04A0A; }

.tl-line {
  flex: 1;
  width: 2rpx;
  background: rgba(22, 32, 43, 0.07);
  margin-top: 6rpx;
}

.tl-body {
  flex: 1;
  padding-bottom: 18rpx;
  min-width: 0;
}

.tl-time {
  font-size: 24rpx;
  color: #C04A0A;
  font-weight: 600;
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.num {
  font-variant-numeric: tabular-nums;
}

.tag {
  font-size: 19rpx;
  color: #5E6A76;
  background: #EEF1F4;
  border-radius: 6rpx;
  padding: 2rpx 8rpx;
  font-weight: 400;
}

.tag.game { color: #B3261E; background: rgba(179, 38, 30, 0.08); }
.tag.drive { color: #C04A0A; background: rgba(192, 74, 10, 0.08); }
.tag.leg { color: #1F4E8C; background: rgba(31, 78, 140, 0.08); }
.tag.xmas { color: #8A5A0B; background: rgba(138, 90, 11, 0.1); }

.tl-text {
  margin-top: 8rpx;
  font-size: 28rpx;
  line-height: 1.66;
  color: #33404C;
}

.tl-xmas {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #8A5A0B;
  line-height: 1.5;
}

.tl-note {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #5E6A76;
}

/* 地址条：一行英文地址 + 导航/复制 */
.addr {
  margin-top: 12rpx;
  background: rgba(22, 32, 43, 0.035);
  border-radius: 12rpx;
  padding: 12rpx 14rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.addr-text {
  flex: 1;
  font-size: 21rpx;
  color: #5E6A76;
  line-height: 1.4;
  word-break: break-word;
}

.addr-actions {
  flex: none;
  display: flex;
  gap: 8rpx;
}

.addr-btn {
  font-size: 21rpx;
  color: #FFFFFF;
  background: #C04A0A;
  border-radius: 999rpx;
  padding: 8rpx 18rpx;
}

.addr-btn.ghost {
  color: #5E6A76;
  background: rgba(22, 32, 43, 0.07);
}

.chips {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 10rpx;
}

.poi-chip {
  font-size: 22rpx;
  color: #1F4E8C;
  border: 1rpx solid rgba(31, 78, 140, 0.25);
  border-radius: 8rpx;
  padding: 6rpx 12rpx;
}

.day-map {
  margin: 18rpx 0 6rpx;
}

.day-map-label {
  font-size: 21rpx;
  color: #5E6A76;
  margin-bottom: 8rpx;
}

.block {
  margin-top: 16rpx;
  font-size: 24rpx;
  line-height: 1.62;
  border-radius: 12rpx;
  padding: 16rpx;
}

.warn {
  color: #8A5A0B;
  background: rgba(138, 90, 11, 0.08);
}

.cut {
  color: #33404C;
  background: rgba(22, 32, 43, 0.04);
}

.tips {
  margin-top: 18rpx;
}

.tips-label {
  font-size: 21rpx;
  color: #A3ADB8;
  letter-spacing: 0.08em;
  margin-bottom: 8rpx;
}

.tip {
  font-size: 24rpx;
  color: #5E6A76;
  line-height: 1.7;
  padding: 2rpx 0;
}

.stay {
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid rgba(22, 32, 43, 0.07);
  font-size: 22rpx;
  color: #5E6A76;
}

.foot-note {
  text-align: center;
  font-size: 21rpx;
  color: #A3ADB8;
  padding: 24rpx 0 10rpx;
}
