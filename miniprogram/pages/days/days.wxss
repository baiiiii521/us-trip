.pad {
  padding: 0 28rpx;
}

.map-card {
  padding: 0;
  overflow: hidden;
  margin-top: 16rpx;
}

.map-head {
  padding: 22rpx 24rpx 14rpx;
}

.map-title {
  font-size: 30rpx;
  font-weight: 700;
}

.map-sub {
  display: block;
  font-size: 22rpx;
  color: #5E6A76;
  margin-top: 4rpx;
  line-height: 1.4;
}

.map {
  width: 100%;
  height: 340rpx;
}

.map.small {
  height: 280rpx;
  border-radius: 16rpx;
}

.map-foot {
  font-size: 22rpx;
  color: #C04A0A;
  padding: 14rpx 24rpx 18rpx;
  border-top: 1rpx solid rgba(22, 32, 43, 0.06);
}

.strip {
  width: 100%;
  white-space: nowrap;
  margin: 18rpx 0 10rpx;
}

.strip-inner {
  display: inline-flex;
  gap: 10rpx;
  padding: 2rpx 0;
}

.strip-item {
  flex: none;
  min-width: 84rpx;
  padding: 10rpx 14rpx;
  border-radius: 14rpx;
  background: #FFFFFF;
  border: 1rpx solid rgba(22, 32, 43, 0.1);
  display: flex;
  flex-direction: column;
  align-items: center;
}

.strip-item.today {
  border-color: rgba(192, 74, 10, 0.5);
}

.strip-item.on {
  background: #16202B;
  border-color: #16202B;
}

.strip-md {
  font-size: 25rpx;
  font-weight: 600;
  color: #16202B;
}

.strip-wd {
  font-size: 19rpx;
  color: #5E6A76;
}

.strip-item.on .strip-md,
.strip-item.on .strip-wd {
  color: #FFFFFF;
}

.toolbar {
  display: flex;
  gap: 12rpx;
  margin: 6rpx 0 4rpx;
}

.chip {
  font-size: 23rpx;
  color: #C04A0A;
  background: rgba(192, 74, 10, 0.09);
  border-radius: 18rpx;
  padding: 10rpx 18rpx;
}

.chip.ghost {
  color: #33404C;
  background: rgba(22, 32, 43, 0.06);
  margin-left: auto;
}

.day {
  padding: 24rpx 24rpx 8rpx;
  margin-top: 18rpx;
}

.day-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10rpx;
}

.day-date {
  display: flex;
  align-items: baseline;
  gap: 10rpx;
}

.day-md {
  font-size: 32rpx;
  font-weight: 700;
}

.day-wd {
  font-size: 22rpx;
  color: #5E6A76;
}

.day-city {
  font-size: 22rpx;
  color: #33404C;
  background: #EEF1F4;
  border-radius: 6rpx;
  padding: 2rpx 10rpx;
}

.day-title {
  margin-top: 8rpx;
  font-size: 29rpx;
  font-weight: 600;
  line-height: 1.4;
}

.day-weather {
  margin-top: 6rpx;
  font-size: 21rpx;
  color: #A3ADB8;
}

/* 收起状态：三行摘要 */
.mini {
  display: flex;
  gap: 14rpx;
  padding: 12rpx 0;
  border-top: 1rpx solid rgba(22, 32, 43, 0.05);
}

.mini:first-of-type {
  margin-top: 14rpx;
}

.mini-time {
  flex: none;
  width: 132rpx;
  font-size: 23rpx;
  color: #C04A0A;
  font-weight: 600;
}

.mini-text {
  flex: 1;
  font-size: 25rpx;
  color: #33404C;
  line-height: 1.5;
}

.more {
  margin-top: 6rpx;
  padding: 18rpx 0;
  text-align: center;
  font-size: 23rpx;
  color: #C04A0A;
  border-top: 1rpx solid rgba(22, 32, 43, 0.06);
}

/* 展开状态 */
.tl {
  display: flex;
  gap: 14rpx;
  padding-top: 16rpx;
}

.tl-rail {
  flex: none;
  width: 14rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.tl-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 6rpx;
  background: rgba(22, 32, 43, 0.22);
  margin-top: 12rpx;
}

.tl-dot.game { background: #B3261E; }
.tl-dot.drive { background: #C04A0A; }

.tl-line {
  flex: 1;
  width: 2rpx;
  background: rgba(22, 32, 43, 0.07);
  margin-top: 6rpx;
}

.tl-body {
  flex: 1;
  padding-bottom: 14rpx;
  min-width: 0;
}

.tl-time {
  font-size: 24rpx;
  color: #C04A0A;
  font-weight: 600;
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.tag {
  font-size: 19rpx;
  color: #5E6A76;
  background: #EEF1F4;
  border-radius: 6rpx;
  padding: 2rpx 8rpx;
  font-weight: 400;
}

.tag.game { color: #B3261E; background: rgba(179, 38, 30, 0.08); }
.tag.drive { color: #C04A0A; background: rgba(192, 74, 10, 0.08); }
.tag.leg { color: #1F4E8C; background: rgba(31, 78, 140, 0.08); }
.tag.xmas { color: #8A5A0B; background: rgba(138, 90, 11, 0.1); }

.tl-text {
  margin-top: 6rpx;
  font-size: 26rpx;
  line-height: 1.62;
  color: #33404C;
}

.tl-xmas {
  margin-top: 6rpx;
  font-size: 23rpx;
  color: #8A5A0B;
  line-height: 1.5;
}

.tl-note {
  margin-top: 6rpx;
  font-size: 24rpx;
  color: #5E6A76;
}

.chips {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 10rpx;
}

.poi-chip {
  font-size: 22rpx;
  color: #1F4E8C;
  border: 1rpx solid rgba(31, 78, 140, 0.25);
  border-radius: 8rpx;
  padding: 4rpx 12rpx;
}

.day-map {
  margin: 18rpx 0 6rpx;
}

.day-map-label {
  font-size: 21rpx;
  color: #5E6A76;
  margin-bottom: 8rpx;
}

.block {
  margin-top: 16rpx;
  font-size: 24rpx;
  line-height: 1.6;
  border-radius: 12rpx;
  padding: 16rpx;
}

.warn {
  color: #8A5A0B;
  background: rgba(138, 90, 11, 0.08);
}

.cut {
  color: #33404C;
  background: rgba(22, 32, 43, 0.04);
}

.tips {
  margin-top: 16rpx;
}

.tips-label {
  font-size: 21rpx;
  color: #A3ADB8;
  letter-spacing: 0.08em;
  margin-bottom: 6rpx;
}

.tip {
  font-size: 24rpx;
  color: #5E6A76;
  line-height: 1.65;
  padding: 2rpx 0;
}

.stay {
  margin-top: 14rpx;
  padding-top: 14rpx;
  border-top: 1rpx solid rgba(22, 32, 43, 0.07);
  font-size: 23rpx;
  color: #5E6A76;
}

.foot-note {
  text-align: center;
  font-size: 21rpx;
  color: #A3ADB8;
  padding: 22rpx 0 10rpx;
}
