<view class="page with-nav">
  <top-bar title="每日行程" sub="{{rentLabel}}" badge="{{badge}}" progress="{{progress}}" />

  <view class="pad">
    <!-- 总览：四座城市怎么走 -->
    <view class="card map-card rise">
      <view class="map-head">
        <text class="map-title">这一趟怎么走</text>
        <text class="map-sub">波士顿 → 华盛顿 → 费城 → 纽约 · 12/31 飞洛杉矶转机</text>
      </view>
      <map
        class="map"
        latitude="{{overview.latitude}}"
        longitude="{{overview.longitude}}"
        scale="{{overview.scale}}"
        markers="{{overview.markers}}"
        polyline="{{overview.polyline}}"
        show-location="{{false}}"
        enable-zoom="{{false}}"
        enable-scroll="{{false}}"
        enable-rotate="{{false}}"
        enable-overlooking="{{false}}"
      />
      <view class="map-foot" bindtap="openOverview" hover-class="tap-dim">在微信地图里打开这片区域 ›</view>
    </view>

    <!-- 日期条 -->
    <scroll-view class="strip" scroll-x="{{true}}" enhanced="{{true}}" show-scrollbar="{{false}}">
      <view class="strip-inner">
        <view
          wx:for="{{strip}}"
          wx:key="id"
          class="strip-item {{activeId === item.id ? 'on' : ''}} {{todayId === item.id ? 'today' : ''}}"
          data-id="{{item.id}}"
          bindtap="jump"
          hover-class="tap-dim"
        >
          <text class="strip-md">{{item.md}}</text>
          <text class="strip-wd">{{item.wd}}</text>
        </view>
      </view>
    </scroll-view>

    <view class="toolbar">
      <view class="chip" bindtap="switchRent" hover-class="tap-dim">交通：{{rentLabel}}</view>
      <view class="chip ghost" bindtap="toTips" hover-class="tap-dim">小技巧</view>
    </view>
  </view>

  <!-- 每天 -->
  <view wx:for="{{days}}" wx:key="id" wx:for-item="day" wx:for-index="di" id="d-{{day.id}}" class="pad">
    <view class="card day rise {{open[day.id] ? 'is-open' : ''}}" style="animation-delay:{{di * 30}}ms">
      <view class="day-head" data-id="{{day.id}}" bindtap="toggle">
        <view class="day-date">
          <text class="day-md">{{day.md}}</text>
          <view class="day-meta">
            <text class="day-wd">{{day.wd}} · {{day.cityZh}}</text>
            <text class="day-weather">{{day.weather}}</text>
          </view>
        </view>
        <text class="pace-dot {{day.pace.lv}}" wx:if="{{day.pace}}">{{day.pace.km}} km</text>
      </view>

      <view class="day-title">{{day.title}}</view>

      <!-- 收起状态：只看前三条，整行可点进导航 -->
      <block wx:if="{{!open[day.id]}}">
        <view
          class="mini {{it.canTap ? 'tap' : ''}}"
          wx:for="{{day.head}}"
          wx:key="t"
          wx:for-item="it"
          wx:for-index="ii"
          data-id="{{day.id}}"
          data-i="{{ii}}"
          bindtap="openItem"
          hover-class="{{it.canTap ? 'tap-dim' : 'none'}}"
        >
          <text class="mini-time">{{it.t || '—'}}</text>
          <text class="mini-text">{{it.short}}</text>
          <text class="mini-go" wx:if="{{it.spot}}">导航</text>
          <text class="mini-go poi" wx:elif="{{it.poi.length}}">景点</text>
        </view>
        <view class="more" data-id="{{day.id}}" bindtap="toggle" hover-class="tap-dim">
          {{day.more ? '展开全部 ' + day.items.length + ' 项' : '展开'}} · 路线图 · 小技巧
        </view>
      </block>

      <!-- 展开状态：全部条目 -->
      <block wx:else>
        <view class="tl" wx:for="{{day.items}}" wx:key="t" wx:for-item="it" wx:for-index="ii">
          <view class="tl-rail">
            <view class="tl-dot {{it.game ? 'game' : ''}} {{it.drive ? 'drive' : ''}}"></view>
            <view class="tl-line"></view>
          </view>
          <view class="tl-body">
            <view class="tl-time">
              <text class="num">{{it.t || '—'}}</text>
              <text class="tag game" wx:if="{{it.game}}">球赛</text>
              <text class="tag drive" wx:if="{{it.drive}}">取还车</text>
              <text class="tag leg" wx:if="{{it.leg}}">城际</text>
              <text class="tag xmas" wx:if="{{it.xmas}}">圣诞</text>
            </view>
            <view class="tl-text">{{it.text}}</view>
            <view class="tl-xmas" wx:if="{{it.xmasNote}}">{{it.xmasNote}}</view>
            <view class="tl-note" wx:if="{{it.note}}">备注：{{it.note}}</view>

            <!-- 地址 + 导航 -->
            <view class="addr" wx:if="{{it.addr || it.spot}}">
              <view class="addr-text" data-id="{{day.id}}" data-i="{{ii}}" bindtap="openItem">{{it.addr || ('导航到：' + it.spot.name)}}</view>
              <view class="addr-actions">
                <view class="addr-btn" data-id="{{day.id}}" data-i="{{ii}}" catchtap="openItem">导航</view>
                <view class="addr-btn ghost" data-q="{{it.addr}}" catchtap="copyAddr">复制</view>
              </view>
            </view>

            <view class="chips" wx:if="{{it.poi.length}}">
              <text
                wx:for="{{it.poi}}"
                wx:key="id"
                wx:for-item="p"
                class="poi-chip"
                data-id="{{p.id}}"
                bindtap="openPoi"
                hover-class="tap-dim"
              >{{p.name}}</text>
            </view>
          </view>
        </view>

        <!-- 当天路线图 -->
        <view class="day-map" wx:if="{{day.map}}">
          <view class="day-map-label">这天的路线（按行程顺序）</view>
          <map
            class="map small"
            latitude="{{day.map.latitude}}"
            longitude="{{day.map.longitude}}"
            scale="{{day.map.scale}}"
            markers="{{day.map.markers}}"
            polyline="{{day.map.polyline}}"
            show-location="{{false}}"
            enable-scroll="{{false}}"
            enable-rotate="{{false}}"
          />
        </view>

        <view class="block warn" wx:if="{{day.warn}}">{{day.warn}}</view>
        <view class="block cut" wx:if="{{day.cut}}">想轻松点：{{day.cut}}</view>
        <view class="tips" wx:if="{{day.tips.length}}">
          <view class="tips-label">小技巧</view>
          <view class="tip" wx:for="{{day.tips}}" wx:key="*this">· {{item}}</view>
        </view>
        <view class="stay" wx:if="{{day.stay}}">今晚住：{{day.stay}}</view>

        <view class="more" data-id="{{day.id}}" bindtap="toggle" hover-class="tap-dim">收起</view>
      </block>
    </view>
  </view>

  <view class="foot-note">内容和 trip.byb521.com 的「每日行程」同源，改内容改网站那份。</view>
</view>

<bottom-nav current="days" tripId="{{tripId}}" />
