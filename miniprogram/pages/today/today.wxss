.clockbar {
  display: flex;
  align-items: baseline;
  gap: 20rpx;
  padding: 8rpx 0 24rpx;
}

.clock {
  display: flex;
  align-items: baseline;
  gap: 8rpx;
}

.clock-label {
  font-size: 22rpx;
  color: #5E6A76;
}

.clock-time {
  font-size: 30rpx;
  font-weight: 600;
  font-variant-numeric: tabular-nums;
  color: #16202B;
}

.clock-mid {
  width: 1rpx;
  height: 22rpx;
  background: rgba(22, 32, 43, 0.2);
}

.clock-note {
  margin-left: auto;
  font-size: 22rpx;
  color: #5E6A76;
}

.hero {
  padding: 0 0 28rpx;
}

.hero-title {
  font-size: 46rpx;
  font-weight: 700;
  line-height: 1.25;
  margin-top: 6rpx;
}

.hero-sub {
  margin-top: 8rpx;
  font-size: 26rpx;
  color: #5E6A76;
}

.next-card {
  border-color: rgba(192, 74, 10, 0.35);
}

.next-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.next-time {
  font-size: 34rpx;
  font-weight: 700;
  color: #C04A0A;
}

.next-text {
  margin-top: 12rpx;
  font-size: 30rpx;
  line-height: 1.55;
  color: #16202B;
}

.next-note {
  margin-top: 8rpx;
  font-size: 26rpx;
  color: #5E6A76;
}

.next-actions {
  margin-top: 24rpx;
}

.nav-btn {
  width: 100%;
}

.row-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 10rpx;
}

.row-time {
  font-size: 26rpx;
  color: #C04A0A;
  font-weight: 600;
}

.between-item {
  display: flex;
  gap: 16rpx;
  padding: 10rpx 0;
}

.between-time {
  flex: none;
  width: 150rpx;
  font-size: 24rpx;
  color: #5E6A76;
}

.between-text {
  flex: 1;
  font-size: 28rpx;
  color: #33404C;
}

.preview-title {
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 12rpx;
}

.preview-item {
  display: flex;
  gap: 16rpx;
  padding: 10rpx 0;
  border-top: 1rpx solid rgba(22, 32, 43, 0.07);
}

.preview-time {
  flex: none;
  width: 150rpx;
  font-size: 24rpx;
  color: #C04A0A;
}

.preview-text {
  flex: 1;
  font-size: 27rpx;
  color: #33404C;
  line-height: 1.5;
}

.pace-row {
  margin-bottom: 12rpx;
}

.warn {
  font-size: 27rpx;
  color: #8A5A0B;
  background: rgba(138, 90, 11, 0.08);
  border-radius: 12rpx;
  padding: 16rpx;
  margin-bottom: 12rpx;
  line-height: 1.55;
}

.tip {
  font-size: 26rpx;
  color: #33404C;
  line-height: 1.6;
  margin-top: 6rpx;
}

.pace-cut {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #5E6A76;
}

.tl {
  display: flex;
  gap: 16rpx;
  padding: 12rpx 0;
}

.tl-dot {
  flex: none;
  width: 12rpx;
  height: 12rpx;
  border-radius: 6rpx;
  background: rgba(22, 32, 43, 0.25);
  margin-top: 16rpx;
}

.tl-dot.game {
  background: #B3261E;
}

.tl-body {
  flex: 1;
}

.tl-time {
  font-size: 25rpx;
  color: #C04A0A;
  font-weight: 600;
}

.tl-text {
  font-size: 27rpx;
  color: #33404C;
  line-height: 1.5;
  margin-top: 2rpx;
}

.stay {
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid rgba(22, 32, 43, 0.1);
  font-size: 25rpx;
  color: #5E6A76;
}

.quick {
  display: flex;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.quick-item {
  flex: 1;
  background: #FFFFFF;
  border: 1rpx solid rgba(22, 32, 43, 0.12);
  border-radius: 20rpx;
  padding: 20rpx 12rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.quick-item:active {
  transform: scale(0.98);
}

.quick-name {
  font-size: 26rpx;
  font-weight: 600;
  color: #16202B;
}

.quick-sub {
  margin-top: 4rpx;
  font-size: 21rpx;
  color: #5E6A76;
}

.foot-link {
  text-align: center;
  font-size: 24rpx;
  color: #5E6A76;
  padding: 8rpx 0 32rpx;
}
