page {
  background: #EFF1F4;
}

/* 城市横幅 */
.banner {
  position: relative;
  height: 320rpx;
  background: #16202B;
  overflow: hidden;
}

.banner-img {
  width: 100%;
  height: 100%;
  animation: drift 26s ease-out both;
}

@keyframes drift {
  from { transform: scale(1.02); }
  to { transform: scale(1.1); }
}

.banner-fade {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: linear-gradient(180deg, rgba(10, 15, 20, 0.45) 0%, rgba(10, 15, 20, 0) 42%, rgba(8, 12, 16, 0.86) 100%);
}

.banner-text {
  position: absolute;
  left: 32rpx;
  right: 32rpx;
  bottom: 22rpx;
}

.banner-city {
  text-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.45);
  font-size: 44rpx;
  font-weight: 800;
  color: #FFFFFF;
  letter-spacing: -0.02em;
}

.banner-wx {
  display: block;
  margin-top: 4rpx;
  font-size: 22rpx;
  font-weight: 500;
  color: rgba(255, 255, 255, 0.88);
  text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.5);
  font-variant-numeric: tabular-nums;
}

/* 大日期 */
.head {
  padding: 28rpx 32rpx 8rpx;
}

.head-big {
  font-size: 42rpx;
  font-weight: 700;
  letter-spacing: -0.02em;
  line-height: 1.3;
  color: #16202B;
}

.head-sub {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #5E6A76;
  line-height: 1.5;
}

.head-pace {
  margin-top: 10rpx;
  display: inline-block;
  font-size: 21rpx;
  color: #33404C;
  background: rgba(22, 32, 43, 0.06);
  border-radius: 999rpx;
  padding: 8rpx 16rpx;
}

/* 现在 */
.now {
  margin: 22rpx 28rpx 0;
  background: #FFFFFF;
  border-radius: 28rpx;
  padding: 26rpx 28rpx 24rpx;
  box-shadow: 0 10rpx 30rpx rgba(16, 24, 32, 0.08);
}

.now-top {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.now-time {
  font-size: 30rpx;
  font-weight: 700;
  color: #C04A0A;
  font-variant-numeric: tabular-nums;
}

.now-flag {
  font-size: 19rpx;
  font-weight: 600;
  letter-spacing: 0.1em;
  color: #FFFFFF;
  background: #C04A0A;
  border-radius: 999rpx;
  padding: 4rpx 12rpx;
}

.now-text {
  margin-top: 12rpx;
  font-size: 28rpx;
  line-height: 1.6;
  color: #16202B;
}

.now-go {
  margin-top: 16rpx;
  display: inline-block;
  font-size: 22rpx;
  font-weight: 600;
  color: #C04A0A;
  background: rgba(192, 74, 10, 0.09);
  border-radius: 999rpx;
  padding: 12rpx 22rpx;
}

/* 分组 */
.section {
  margin: 34rpx 36rpx 12rpx;
  font-size: 21rpx;
  font-weight: 600;
  letter-spacing: 0.12em;
  color: #8A94A0;
}

.card {
  margin: 0 28rpx;
  background: #FFFFFF;
  border-radius: 28rpx;
  box-shadow: 0 2rpx 10rpx rgba(16, 24, 32, 0.05);
}

.row-press {
  opacity: 0.6;
}

/* 出发前 */
.list {
  padding: 2rpx 28rpx;
}

.row {
  display: flex;
  gap: 18rpx;
  padding: 24rpx 0;
  border-bottom: 1rpx solid rgba(22, 32, 43, 0.06);
}

.row:last-child {
  border-bottom: none;
}

.row-time {
  flex: none;
  width: 110rpx;
  font-size: 22rpx;
  font-weight: 600;
  color: #1F4E8C;
  font-variant-numeric: tabular-nums;
}

.row-body {
  flex: 1;
  min-width: 0;
}

.row-text {
  font-size: 28rpx;
  line-height: 1.55;
  color: #16202B;
}

.row-go {
  display: block;
  margin-top: 8rpx;
  font-size: 21rpx;
  color: #C04A0A;
}

/* 时间轴 */
.timeline {
  padding: 10rpx 28rpx 6rpx;
}

.tl {
  display: flex;
  gap: 16rpx;
  padding-top: 18rpx;
}

.tl-rail {
  flex: none;
  width: 14rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.tl-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 6rpx;
  background: rgba(22, 32, 43, 0.2);
  margin-top: 12rpx;
}

.tl-dot.past {
  background: rgba(22, 32, 43, 0.14);
}

.tl-dot.hot {
  background: #C04A0A;
}

.tl-dot.next {
  background: #C04A0A;
  box-shadow: 0 0 0 6rpx rgba(192, 74, 10, 0.16);
}

.tl-line {
  flex: 1;
  width: 2rpx;
  background: rgba(22, 32, 43, 0.07);
  margin-top: 6rpx;
}

.tl-body {
  flex: 1;
  padding-bottom: 22rpx;
  min-width: 0;
}

.tl-top {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.tl-time {
  font-size: 24rpx;
  font-weight: 600;
  color: #16202B;
  font-variant-numeric: tabular-nums;
}

.tl-time.past {
  color: #A3ADB8;
  font-weight: 500;
}

.tl-tag {
  font-size: 19rpx;
  color: #5E6A76;
  background: #EEF1F4;
  border-radius: 6rpx;
  padding: 2rpx 8rpx;
}

.tl-text {
  display: block;
  margin-top: 8rpx;
  font-size: 28rpx;
  line-height: 1.62;
  color: #33404C;
}

.tl-note {
  display: block;
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #8A94A0;
}

.tl-go {
  display: inline-block;
  margin-top: 10rpx;
  font-size: 21rpx;
  color: #C04A0A;
  border: 1rpx solid rgba(192, 74, 10, 0.3);
  border-radius: 999rpx;
  padding: 6rpx 14rpx;
}

/* 提示 */
.warn {
  margin-top: 18rpx;
  padding: 22rpx 26rpx;
  font-size: 24rpx;
  line-height: 1.65;
  color: #8A5A0B;
  background: #FFF8EC;
}

.tips {
  padding: 20rpx 26rpx;
}

.tip {
  font-size: 24rpx;
  line-height: 1.7;
  color: #5E6A76;
}

.stay {
  margin: 22rpx 36rpx 0;
  font-size: 22rpx;
  color: #8A94A0;
}

/* 三地时间 */
.clocks {
  display: flex;
  gap: 12rpx;
  margin: 32rpx 28rpx 40rpx;
}

.clock {
  flex: 1;
  background: rgba(22, 32, 43, 0.045);
  border-radius: 28rpx;
  padding: 18rpx 0;
  text-align: center;
}

.cl-city {
  display: block;
  font-size: 19rpx;
  color: #8A94A0;
  letter-spacing: 0.06em;
}

.cl-time {
  display: block;
  margin-top: 4rpx;
  font-size: 30rpx;
  font-weight: 600;
  color: #16202B;
  font-variant-numeric: tabular-nums;
}

.tap-dim {
  opacity: 0.65;
}

/* 出发前预览的出口：想看全天就去行程页那一天 */
.see-all {
  margin: 0 28rpx;
  padding: 22rpx 0;
  text-align: center;
  font-size: 23rpx;
  color: #C04A0A;
  background: #FFFFFF;
  border-radius: 0 0 28rpx 28rpx;
  margin-top: -20rpx;
}
