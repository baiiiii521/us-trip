/* 今天：上半是午夜蓝站牌，下半是一天的线路 */
.page {
  min-height: 100vh;
  background: var(--ground);
}

.board {
  background: var(--night);
  color: var(--on-night);
  padding: 10rpx 32rpx 22rpx;
}

/* 五城线 */
.cities {
  display: flex;
  align-items: flex-start;
  padding: 4rpx 0 20rpx;
}

.city-seg {
  flex: 1;
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.seg-line {
  position: absolute;
  top: 17rpx;
  right: 50%;
  width: 100%;
  height: 8rpx;
  border-radius: 4rpx;
}

.seg-stop {
  position: relative;
  z-index: 1;
  width: 30rpx;
  height: 30rpx;
  margin-top: 6rpx;
  border-radius: 50%;
  background: var(--night);
  border: 7rpx solid;
  box-sizing: border-box;
}

.seg-stop.past {
  background: #FFFFFF;
}

.seg-stop.now,
.seg-stop.next {
  width: 42rpx;
  height: 42rpx;
  margin-top: 0;
  background: #FFFFFF;
  border-width: 10rpx;
  box-shadow: 0 0 0 6rpx var(--night), 0 0 0 9rpx rgba(255, 255, 255, 0.85);
}

.seg-stop.later {
  opacity: 0.55;
}

.seg-name {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: var(--on-night-2);
}

.seg-name.now,
.seg-name.next {
  color: #FFFFFF;
  font-weight: 700;
}

.seg-name.later {
  color: #8C9AC0;
}

/* 城市图 + 城名 + 天气 */
.photo {
  position: relative;
  height: 300rpx;
  background: var(--night-3);
  overflow: hidden;
}

.photo-img {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
}

/* 往下渐变进午夜蓝，城名压在暗部；不是装饰，是让白字看得清 */
.photo-fade {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 75%;
  background: linear-gradient(180deg, rgba(0, 0, 0, 0) 0%, rgba(0, 0, 0, 0.18) 45%, var(--night) 100%);
}

.photo-credit {
  position: absolute;
  right: 20rpx;
  top: 16rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.82);
  padding: 4rpx 12rpx;
  border-radius: 999rpx;
  background: rgba(14, 26, 58, 0.45);
}

.where {
  position: absolute;
  left: 32rpx;
  right: 32rpx;
  bottom: 24rpx;
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 24rpx;
}

.where-l {
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.where-city {
  font-size: 68rpx;
  line-height: 1.08;
  font-weight: 800;
  letter-spacing: -0.02em;
  color: #FFFFFF;
}

.where-day {
  margin-top: 10rpx;
  font-size: 26rpx;
  color: var(--on-night-2);
}

.where-r {
  flex: none;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
}

.wx-big {
  font-size: 56rpx;
  line-height: 1;
  font-weight: 300;
  color: #FFFFFF;
}

.wx-small {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: var(--on-night-2);
}

.clocks {
  display: flex;
  justify-content: space-between;
  padding-top: 18rpx;
  border-top: 1rpx solid var(--line-night);
}

.clock {
  display: flex;
  align-items: baseline;
  gap: 10rpx;
}

.cl-city {
  font-size: 24rpx;
  color: var(--on-night-2);
}

.cl-time {
  font-size: 30rpx;
  font-weight: 650;
  color: #FFFFFF;
}

/* 强度 */
.pace {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin: 22rpx 32rpx 0;
}

.pace-bars {
  display: flex;
  gap: 4rpx;
}

.pb {
  width: 12rpx;
  height: 24rpx;
  border-radius: 3rpx;
  background: #D5DAE5;
}

.pb.on {
  background: var(--ink);
}

.pace-text {
  font-size: 24rpx;
  color: var(--ink-2);
}

.sec {
  margin: 26rpx 32rpx 14rpx;
  font-size: 30rpx;
  font-weight: 750;
  color: var(--ink);
}

/* ── 一天的线路 ── */
.route {
  padding: 0 32rpx 0 20rpx;
}

.st {
  display: flex;
  align-items: stretch;
}

.rail {
  position: relative;
  flex: none;
  width: 72rpx;
  display: flex;
  justify-content: center;
}

.rail-line {
  position: absolute;
  top: 0;
  bottom: 0;
  left: 32rpx;
  width: 8rpx;
}

.rail-line.first {
  top: 20rpx;
}

.st:last-child .rail-line {
  bottom: auto;
  height: 24rpx;
}

.rail .stop {
  position: relative;
  z-index: 1;
  margin-top: 6rpx;
}

.rail .stop.past {
  margin-top: 10rpx;
}

.rail .stop.next {
  margin-top: 0;
  animation: pulse 1600ms cubic-bezier(0.16, 1, 0.3, 1) infinite;
}

.st-body {
  flex: 1;
  min-width: 0;
  padding: 0 0 40rpx 12rpx;
}

.st.past .st-body {
  padding-bottom: 28rpx;
}

.fold-body {
  min-height: 60rpx;
  padding-top: 4rpx;
  font-size: 26rpx;
  font-weight: 650;
  color: var(--ink-2);
}

.st-top {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 12rpx;
  min-height: 42rpx;
}

.st-time {
  font-size: 30rpx;
  font-weight: 750;
  color: var(--ink);
}

.st.past .st-time {
  color: #5E6A84;
  font-weight: 600;
}

.st-flag {
  font-size: 24rpx;
  font-weight: 700;
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
}

.st-flag.now {
  background: var(--night);
  color: #FFFFFF;
}

.st-flag.next {
  background: var(--go);
  color: var(--go-ink);
}

.st-tag {
  font-size: 24rpx;
  color: var(--muted);
  padding: 2rpx 12rpx;
  border-radius: 999rpx;
  box-shadow: inset 0 0 0 2rpx var(--line);
}

.st-text {
  display: block;
  margin-top: 8rpx;
  font-size: 29rpx;
  line-height: 1.6;
  color: var(--ink-2);
}

.st.past .st-text {
  font-size: 25rpx;
  color: #5E6A84;
}

.st.now .st-text {
  color: var(--ink);
  font-weight: 600;
}

.st-note,
.next-note {
  display: block;
  margin-top: 10rpx;
  font-size: 24rpx;
  line-height: 1.5;
  color: var(--warn);
}

.st-go {
  display: inline-flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 14rpx;
  min-height: 60rpx;
  padding: 0 22rpx;
  border-radius: 999rpx;
  background: var(--panel);
  font-size: 24rpx;
  font-weight: 600;
  color: var(--ink);
  box-shadow: inset 0 0 0 2rpx var(--line);
}

.st-go-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: var(--l-phl);
}

/* 下一站的白卡 */
.next-card {
  margin-top: 14rpx;
  padding: 26rpx 28rpx 28rpx;
  border-radius: 24rpx;
  background: var(--panel);
  box-shadow: 0 2rpx 6rpx rgba(14, 26, 58, 0.06), 0 16rpx 36rpx -20rpx rgba(14, 26, 58, 0.35);
}

.next-text {
  display: block;
  font-size: 31rpx;
  line-height: 1.55;
  font-weight: 600;
  color: var(--ink);
}

.next-go {
  margin-top: 24rpx;
}

.see-all {
  margin: 0 32rpx;
}

.warn {
  margin: 8rpx 32rpx 0;
}

.tips {
  margin: 0 32rpx;
}

.tip {
  font-size: 27rpx;
  line-height: 1.6;
  color: var(--ink-2);
  padding: 14rpx 0;
  border-bottom: 1rpx solid var(--line);
}

.tip:last-child {
  border-bottom: none;
}

.stay {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  margin: 28rpx 32rpx 0;
  padding: 26rpx 28rpx;
  border-radius: 24rpx;
  background: var(--night);
}

.stay-k {
  font-size: 24rpx;
  color: var(--on-night-2);
}

.stay-v {
  font-size: 27rpx;
  line-height: 1.5;
  color: #FFFFFF;
}
