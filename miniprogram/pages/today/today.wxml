<view class="page with-nav">
  <top-bar show-back title="今天" sub="{{barSub}}" badge="{{badge}}" />

  <!-- 城市图：白天是实拍，天黑后是 AI 夜景；城名和天气压在图的暗部 -->
  <view class="photo">
    <image class="photo-img" wx:if="{{img.src && !imgFail}}" src="{{img.src}}" mode="aspectFill" binderror="imgError" />
    <view class="photo-fade"></view>
    <view class="where">
      <view class="where-l">
        <text class="where-city">{{phase === 'before' ? bigLine : cityZh}}</text>
        <text class="where-day num">{{subLine}}</text>
      </view>
      <view class="where-r" wx:if="{{weather}}">
        <text class="wx-big num">{{weatherHi}}</text>
        <text class="wx-small">{{weatherLo}}</text>
      </view>
    </view>
    <text class="photo-credit" wx:if="{{img.src && !imgFail}}">{{img.credit}}</text>
  </view>

  <!-- 午夜蓝站牌：五城线、三地时间 -->
  <view class="board">
    <view class="cities">
      <view class="city-seg" wx:for="{{stations}}" wx:key="key">
        <view class="seg-line" wx:if="{{index > 0}}" style="background:{{item.color}};opacity:{{item.state === 'later' ? 0.3 : 1}}"></view>
        <view class="seg-stop {{item.state}}" style="border-color:{{item.color}}"></view>
        <text class="seg-name {{item.state}}">{{item.name}}</text>
      </view>
    </view>

    <view class="clocks">
      <view class="clock" wx:for="{{clocks}}" wx:key="city">
        <text class="cl-city">{{item.city}}</text>
        <text class="cl-time num">{{item.time}}</text>
      </view>
    </view>
  </view>

  <view class="pace" wx:if="{{phase === 'on' && paceText}}">
    <view class="pace-bars"><view class="pb {{paceLv >= 1 ? 'on' : ''}}"></view><view class="pb {{paceLv >= 2 ? 'on' : ''}}"></view><view class="pb {{paceLv >= 3 ? 'on' : ''}}"></view></view>
    <text class="pace-text">{{paceShort}}</text>
  </view>

  <view class="sec">{{phase === 'before' ? '落地第一天' : phase === 'after' ? '最后一天' : dayTitle}}</view>

  <!-- 一天一条线：每一项是一站 -->
  <view class="route">
    <view class="st past-fold" wx:if="{{phase === 'on' && pastCount}}" bindtap="togglePast" hover-class="tap-dim">
      <view class="rail"><view class="rail-line first" style="background:#C9CFDC"></view><view class="stop past"></view></view>
      <view class="st-body fold-body">{{showPast ? '收起走过的站' : '已走过 ' + pastCount + ' 站 · 点开看'}}</view>
    </view>
    <view
      class="st {{it.state}} {{it.xfer ? 'xfer' : ''}}"
      wx:for="{{phase === 'before' ? preview : items}}"
      wx:key="i"
      wx:for-item="it"
      wx:for-index="k"
      wx:if="{{!it.hide || showPast}}"
    >
      <view class="rail">
        <view class="rail-line {{k === 0 ? 'first' : ''}}" style="background:{{it.state === 'past' ? '#C9CFDC' : line}}"></view>
        <view class="stop {{it.state}} {{it.xfer ? 'xfer' : ''}}" style="border-color:{{it.state === 'next' ? '#FFC233' : it.state === 'past' ? '#C9CFDC' : line}}"></view>
      </view>

      <view class="st-body">
        <view class="st-top">
          <text class="st-time num">{{it.t}}</text>
          <text class="st-flag now" wx:if="{{it.state === 'now'}}">现在</text>
          <text class="st-flag next" wx:if="{{it.state === 'next'}}">{{phase === 'before' ? '第一站' : '下一站 · ' + nextCount}}</text>
          <text class="st-tag" wx:if="{{it.tag}}">{{it.tag}}</text>
        </view>

        <!-- 下一站：展开成一张白卡，导航按钮在这里 -->
        <view class="next-card" wx:if="{{it.state === 'next'}}">
          <text class="next-text">{{it.text}}</text>
          <text class="next-note" wx:if="{{it.note}}">备注：{{it.note}}</text>
          <view class="btn-primary next-go" wx:if="{{it.spot}}" data-i="{{it.i}}" bindtap="goItem">导航过去 · {{it.spot.name}}</view>
        </view>

        <block wx:else>
          <text class="st-text">{{it.state === 'past' ? it.short : it.text}}</text>
          <text class="st-note" wx:if="{{it.note}}">备注：{{it.note}}</text>
          <view class="st-go" wx:if="{{it.spot && it.state !== 'past'}}" data-i="{{it.i}}" catchtap="goItem" hover-class="tap-dim">
            <view class="st-go-dot"></view>导航 · {{it.spot.name}}
          </view>
        </block>
      </view>
    </view>
  </view>

  <view hover-class="press" hover-stay-time="60" class="btn-ghost see-all" wx:if="{{phase === 'before'}}" bindtap="openDay">看第一天全部 {{itemCount}} 站</view>

  <block wx:if="{{phase !== 'before'}}">
    <view class="notice warn" wx:if="{{warn}}">{{warn}}</view>

    <view class="sec" wx:if="{{tips.length}}">今天的小技巧</view>
    <view class="card tips" wx:if="{{tips.length}}">
      <view class="tip" wx:for="{{tips}}" wx:key="*this">{{item}}</view>
    </view>

    <view class="stay" wx:if="{{stay}}">
      <text class="stay-k">今晚住</text>
      <text class="stay-v">{{stay}}</text>
    </view>
  </block>
</view>

<bottom-nav current="today" tripId="{{tripId}}" />
