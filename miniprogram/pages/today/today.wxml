<view class="page with-nav">
  <top-bar title="今天" sub="{{barSub}}" badge="{{badge}}" progress="{{progress}}" />

  <!-- 城市横幅 -->
  <view class="banner">
    <image class="banner-img" wx:if="{{photo}}" src="{{photo}}" mode="aspectFill" />
    <view class="banner-fade"></view>
    <view class="banner-text">
      <text class="banner-city">{{cityZh || '在路上'}}</text>
      <text class="banner-wx" wx:if="{{weather}}">{{weather}}</text>
    </view>
  </view>

  <!-- 今天第几天 -->
  <view class="head">
    <view class="head-big">{{bigLine}}</view>
    <view class="head-sub">{{subLine}}</view>
    <view class="head-pace" wx:if="{{paceText}}">{{paceText}}</view>
  </view>

  <!-- 现在做的那件事 -->
  <view class="now" wx:if="{{nowIndex >= 0 && phase === 'on'}}">
    <view class="now-top">
      <text class="now-time">{{items[nowIndex].t}}</text>
      <text class="now-flag">现在</text>
    </view>
    <view class="now-text">{{items[nowIndex].text}}</view>
    <view class="now-go" wx:if="{{items[nowIndex].spot}}" data-i="{{nowIndex}}" bindtap="goItem" hover-class="tap-dim">
      导航去 {{items[nowIndex].spot.name}} ›
    </view>
  </view>

  <!-- 出发前：先给第一天的前四件事 -->
  <block wx:if="{{phase === 'before'}}">
    <view class="section">落地第一天</view>
    <view class="card list">
      <view class="row" wx:for="{{preview}}" wx:key="i" wx:for-item="it" data-i="{{it.i}}" bindtap="goItem" hover-class="row-press">
        <text class="row-time">{{it.t}}</text>
        <view class="row-body">
          <text class="row-text">{{it.text}}</text>
          <text class="row-go" wx:if="{{it.spot}}">导航 · {{it.spot.name}}</text>
        </view>
      </view>
    </view>
    <view hover-class="press" hover-stay-time="60" class="see-all" bindtap="openDay">
      看全天 {{itemCount}} 项 ›
    </view>
  </block>

  <!-- 全天时间轴 -->
  <block wx:else>
    <view class="section">今天的时间</view>
    <view class="card timeline">
      <view class="tl" wx:for="{{items}}" wx:key="i" wx:for-item="it">
        <view class="tl-rail">
          <view class="tl-dot {{it.state}} {{it.hot ? 'hot' : ''}}"></view>
          <view class="tl-line"></view>
        </view>
        <view class="tl-body">
          <view class="tl-top">
            <text class="tl-time {{it.state}}">{{it.t}}</text>
            <text class="tl-tag" wx:if="{{it.tag}}">{{it.tag}}</text>
          </view>
          <text class="tl-text">{{it.text}}</text>
          <text class="tl-note" wx:if="{{it.note}}">备注：{{it.note}}</text>
          <view class="tl-go" wx:if="{{it.spot}}" data-i="{{it.i}}" catchtap="goItem" hover-class="tap-dim">
            导航 · {{it.spot.name}}
          </view>
        </view>
      </view>
    </view>

    <view class="card warn" wx:if="{{warn}}">{{warn}}</view>

    <view class="section" wx:if="{{tips.length}}">小技巧</view>
    <view class="card tips" wx:if="{{tips.length}}">
      <view class="tip" wx:for="{{tips}}" wx:key="*this">· {{item}}</view>
    </view>

    <view class="stay" wx:if="{{stay}}">今晚住 {{stay}}</view>
  </block>

  <!-- 三个地方的时间 -->
  <view class="clocks">
    <view class="clock" wx:for="{{clocks}}" wx:key="city">
      <text class="cl-city">{{item.city}}</text>
      <text class="cl-time">{{item.time}}</text>
    </view>
  </view>
</view>

<bottom-nav current="today" tripId="{{tripId}}" />
