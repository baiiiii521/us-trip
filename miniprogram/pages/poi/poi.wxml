<view class="page-pad" wx:if="{{poi}}">
  <!-- 封面：维基首图（构建时抓好的地址），加载失败退回城市色排印块 -->
  <image
    wx:if="{{poi.photo}}"
    class="hero"
    src="{{poi.photo.src}}"
    mode="aspectFill"
    binderror="onPhotoError"
  />
  <view class="cover" wx:else style="background:{{poi.coverColor}}">
    <text class="cover-en">{{poi.en}}</text>
    <text class="cover-city">{{poi.cityZh}} · {{poi.catZh}}</text>
  </view>
  <view class="credit" wx:if="{{poi.photo && poi.credit}}">图片：{{poi.credit}}</view>

  <view class="title">{{poi.name}}</view>
  <view class="tag">{{poi.tag}}</view>

  <view class="actions">
    <view class="btn-primary half" bindtap="nav">{{ll ? '导航到这里' : '复制地址'}}</view>
    <view class="btn-ghost half" bindtap="copy">复制英文地址</view>
  </view>

  <view class="card">
    <view class="body-text">{{poi.intro}}</view>
    <view class="hairline" wx:if="{{poi.highlights.length}}"></view>
    <view class="hl" wx:for="{{poi.highlights}}" wx:key="*this">· {{item}}</view>
  </view>

  <view class="card">
    <view class="kv"><text class="k">开放时间</text><text class="val">{{poi.open}}</text></view>
    <view class="kv"><text class="k">门票</text><text class="val">{{poi.ticket}}</text></view>
    <view class="kv"><text class="k">建议停留</text><text class="val">{{poi.stay}}</text></view>
    <view class="kv"><text class="k">怎么去</text><text class="val">{{poi.transit}}</text></view>
    <view class="kv" wx:if="{{poi.tip}}"><text class="k">提示</text><text class="val tipv">{{poi.tip}}</text></view>
  </view>

  <view class="card" wx:if="{{days.length}}">
    <view class="section-label">安排在这几天</view>
    <view class="day-links">
      <view class="day-link" wx:for="{{days}}" wx:key="id" data-id="{{item.id}}" bindtap="jumpDay">
        <text class="day-md">{{item.md}}</text>
        <text class="day-t">{{item.title}}</text>
      </view>
    </view>
  </view>

  <view class="foot-note">图片来自维基百科 / 维基共享资源，点击标题可在浏览器查看原图。文字内容与 trip.byb521.com 同源。</view>
</view>

<view class="page-pad" wx:else>
  <view class="card"><view class="body-text">没找到这个地点。</view></view>
</view>
