.hero {
  width: 100%;
  height: 420rpx;
  border-radius: 28rpx;
  margin-bottom: 8rpx;
  background: #EEF1F4;
}

.credit {
  font-size: 21rpx;
  color: #A3ADB8;
  margin: 0 4rpx 16rpx;
}

.cover {
  height: 260rpx;
  border-radius: 28rpx;
  padding: 24rpx;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
  margin-bottom: 24rpx;
}

.cover-en {
  color: rgba(255, 255, 255, 0.95);
  font-size: 34rpx;
  font-weight: 700;
  letter-spacing: 0.04em;
  line-height: 1.3;
}

.cover-city {
  margin-top: 6rpx;
  color: rgba(255, 255, 255, 0.75);
  font-size: 22rpx;
}

.tag {
  font-size: 28rpx;
  color: #5E6A76;
  margin-top: 8rpx;
  margin-bottom: 24rpx;
  line-height: 1.5;
}

.actions {
  display: flex;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.half {
  flex: 1;
}

.hl {
  font-size: 28rpx;
  color: #33404C;
  line-height: 1.6;
  padding: 4rpx 0;
}

.kv {
  display: flex;
  gap: 20rpx;
  padding: 10rpx 0;
  border-bottom: 1rpx solid rgba(22, 32, 43, 0.06);
}

.kv:last-child {
  border-bottom: none;
}

.k {
  flex: none;
  width: 150rpx;
  font-size: 24rpx;
  color: #5E6A76;
}

.val {
  flex: 1;
  font-size: 28rpx;
  color: #16202B;
  line-height: 1.5;
}

.tipv {
  color: #33404C;
}

.day-links {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.day-link {
  display: flex;
  align-items: baseline;
  gap: 16rpx;
  padding: 10rpx 0;
  border-bottom: 1rpx solid rgba(22, 32, 43, 0.06);
}

.day-md {
  flex: none;
  width: 90rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: #C04A0A;
}

.day-t {
  flex: 1;
  font-size: 28rpx;
  color: #33404C;
}

.foot-note {
  font-size: 22rpx;
  color: #A3ADB8;
  line-height: 1.6;
  padding: 8rpx 4rpx 40rpx;
}

/* 底部常驻操作条（材质层，内容从下面滚过） */
.action-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  gap: 16rpx;
  padding: 18rpx 28rpx calc(18rpx + env(safe-area-inset-bottom));
  background: rgba(255, 255, 255, 0.84);
  backdrop-filter: blur(24px) saturate(180%);
  -webkit-backdrop-filter: blur(24px) saturate(180%);
  z-index: 45;
}

.action-bar::before {
  content: '';
  position: absolute;
  left: 0;
  right: 0;
  top: -14rpx;
  height: 14rpx;
  background: linear-gradient(0deg, rgba(16, 24, 32, 0.07), rgba(16, 24, 32, 0));
}

.bar-main {
  flex: 1;
}

.bar-ghost {
  flex: none;
  min-width: 168rpx;
}

.page-pad {
  padding-bottom: calc(180rpx + env(safe-area-inset-bottom));
}
