.cover {
  height: 260rpx;
  border-radius: 24rpx;
  padding: 24rpx;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
  margin-bottom: 24rpx;
}

.cover-en {
  color: rgba(255, 255, 255, 0.95);
  font-size: 34rpx;
  font-weight: 700;
  letter-spacing: 0.04em;
  line-height: 1.3;
}

.cover-city {
  margin-top: 6rpx;
  color: rgba(255, 255, 255, 0.75);
  font-size: 22rpx;
}

.tag {
  font-size: 27rpx;
  color: #5E6A76;
  margin-top: 8rpx;
  margin-bottom: 24rpx;
  line-height: 1.5;
}

.actions {
  display: flex;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.half {
  flex: 1;
}

.hl {
  font-size: 26rpx;
  color: #33404C;
  line-height: 1.6;
  padding: 4rpx 0;
}

.kv {
  display: flex;
  gap: 20rpx;
  padding: 10rpx 0;
  border-bottom: 1rpx solid rgba(22, 32, 43, 0.06);
}

.kv:last-child {
  border-bottom: none;
}

.k {
  flex: none;
  width: 150rpx;
  font-size: 24rpx;
  color: #5E6A76;
}

.val {
  flex: 1;
  font-size: 26rpx;
  color: #16202B;
  line-height: 1.5;
}

.tipv {
  color: #33404C;
}

.day-links {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.day-link {
  display: flex;
  align-items: baseline;
  gap: 16rpx;
  padding: 10rpx 0;
  border-bottom: 1rpx solid rgba(22, 32, 43, 0.06);
}

.day-md {
  flex: none;
  width: 90rpx;
  font-size: 25rpx;
  font-weight: 600;
  color: #C04A0A;
}

.day-t {
  flex: 1;
  font-size: 26rpx;
  color: #33404C;
}

.foot-note {
  font-size: 22rpx;
  color: #A3ADB8;
  line-height: 1.6;
  padding: 8rpx 4rpx 40rpx;
}
