.sos .section-label {
  margin: 0 0 18rpx;
  font-size: 30rpx;
  color: var(--ink);
}

.sos-row {
  display: flex;
  gap: 16rpx;
}

.sos-btn {
  flex: 1;
}

/* 911 用红色：这里是唯一一个不是「去哪」的大按钮 */
.sos-row .btn-primary {
  background: var(--crit);
  color: #FFFFFF;
  box-shadow: 0 8rpx 20rpx -10rpx rgba(160, 20, 20, 0.6);
}

.sos-note {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: var(--muted);
  line-height: 1.55;
}

.consul {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  padding: 14rpx 0;
}

.consul-main {
  flex: 1;
}

.consul-name {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--ink);
}

.consul-area {
  display: block;
  font-size: 24rpx;
  color: var(--muted);
  margin-top: 2rpx;
}

.consul-addr {
  display: block;
  font-size: 24rpx;
  color: var(--muted);
  margin-top: 2rpx;
}

.consul-call {
  flex: none;
  min-height: 64rpx;
  display: flex;
  align-items: center;
  padding: 0 22rpx;
  border-radius: 999rpx;
  background: var(--night);
  color: #FFFFFF;
  font-size: 24rpx;
  font-weight: 650;
  font-variant-numeric: tabular-nums;
}

.tip {
  font-size: 24rpx;
  color: var(--ink-2);
  line-height: 1.6;
  padding: 4rpx 0;
}

.entry {
  display: flex;
  align-items: center;
  min-height: 96rpx;
  padding: 14rpx 0;
  border-bottom: 1rpx solid rgba(14, 26, 58, 0.07);
}

.entry-name {
  font-size: 29rpx;
  font-weight: 650;
  color: var(--ink);
  flex: none;
  width: 200rpx;
}

.entry-sub {
  flex: 1;
  font-size: 24rpx;
  color: var(--muted);
  line-height: 1.4;
}

.entry-go {
  flex: none;
  font-size: 30rpx;
  color: var(--muted);
  margin-left: 12rpx;
}

.entry-go.soon {
  font-size: 24rpx;
  font-weight: 650;
  color: var(--muted);
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
  box-shadow: inset 0 0 0 2rpx var(--line);
}

.set-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 92rpx;
  padding: 10rpx 0;
  border-bottom: 1rpx solid rgba(14, 26, 58, 0.07);
}

.set-label {
  font-size: 28rpx;
  color: var(--ink-2);
}

.set-val {
  font-size: 28rpx;
  color: var(--ink);
}

.set-note {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: var(--muted);
  line-height: 1.5;
}

.kv {
  display: flex;
  gap: 20rpx;
  padding: 10rpx 0;
}

.k {
  flex: none;
  width: 120rpx;
  font-size: 24rpx;
  color: var(--muted);
}

.val {
  flex: 1;
  font-size: 28rpx;
  color: var(--ink);
  line-height: 1.5;
}

.about {
  text-align: center;
  font-size: 24rpx;
  color: var(--muted);
  padding: 16rpx 0 32rpx;
}
