<view class="page">
  <!-- 封面：整幅图压到状态栏下面，白字压在暗部 -->
  <view class="hero" style="padding-top:{{sb}}px">
    <image class="hero-img" wx:if="{{hero.cover}}" src="{{hero.cover}}" mode="aspectFill" />
    <view class="hero-fade"></view>

    <view class="hero-top">
      <image class="mark" src="/assets/logo.png" mode="aspectFill" />
      <text class="mark-name">行前行后</text>
      <text class="phase {{hero.phaseKey}}">{{hero.phaseLabel}}</text>
    </view>

    <view class="hero-body">
      <view class="hero-title">{{hero.title}}</view>
      <view class="hero-meta">{{hero.metaText}}</view>

      <view class="cta" data-id="{{hero.id}}" bindtap="openTrip" hover-class="cta-press">
        <text class="cta-text">进入行程</text>
        <text class="cta-arrow">→</text>
      </view>
    </view>

    <text class="credit" wx:if="{{hero.credit}}">{{hero.credit}}</text>
  </view>

  <!-- 今天 / 出发前 -->
  <view class="now" wx:if="{{now}}">
    <view class="now-head">
      <text class="now-label">{{now.label}}</text>
      <text class="now-nav" wx:if="{{now.canNav}}" bindtap="navNow" hover-class="tap-dim">导航 ›</text>
    </view>
    <view class="now-title">{{now.title}}</view>
    <view class="now-sub">{{now.sub}}</view>
    <view class="now-detail" wx:if="{{now.detail}}">{{now.detail}}</view>
  </view>

  <!-- 工具：分组列表，一行一件事 -->
  <view class="section">工具</view>
  <view class="card group">
    <view
      class="row"
      wx:for="{{tools}}"
      wx:key="key"
      data-url="{{item.url}}"
      bindtap="go"
      hover-class="row-press"
    >
      <view class="row-l">
        <text class="row-name">{{item.name}}</text>
        <text class="row-sub">{{item.sub}}</text>
      </view>
      <text class="row-chev">›</text>
    </view>
  </view>

  <!-- 所有旅程 -->
  <view class="section">所有旅程</view>
  <view
    class="card trip"
    wx:for="{{trips}}"
    wx:key="id"
    data-id="{{item.id}}"
    bindtap="openTrip"
    hover-class="row-press"
  >
    <view class="trip-l">
      <text class="trip-name">{{item.title}}</text>
      <text class="trip-meta">{{item.dateText}} · {{item.days}} 天 · {{item.people}} 人</text>
      <text class="trip-trail">{{item.trail}}</text>
    </view>
    <text class="trip-chev">›</text>
  </view>

  <view class="foot">内容与 trip.byb521.com 同源 · 改内容改网站那份</view>
</view>
