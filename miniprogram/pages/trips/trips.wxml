<view class="page">
  <!-- 页头：自己让开状态栏（页面是自定义导航栏），品牌行 + 大标题 -->
  <view class="hero" style="padding-top:{{sb + 10}}px">
  <view class="brand">
    <image class="mark" src="/assets/logo.png" mode="aspectFill" />
    <text class="mark-name">行前行后</text>
    <text class="phase {{hero.phaseKey}}">{{hero.phaseLabel}}</text>
  </view>

  <view class="lede">我的旅行</view>
  </view>

  <!-- 这一趟：封面图 + 五城线路 -->
  <view class="trip-card" wx:if="{{hero}}" data-id="{{hero.id}}" bindtap="openTrip" hover-class="card-press">
    <view class="cover">
      <image class="cover-img" wx:if="{{hero.cover}}" src="{{hero.cover}}" mode="aspectFill" />
      <view class="cover-fade"></view>
      <view class="cover-text">
        <text class="cover-title">{{hero.title}}</text>
        <text class="cover-meta num">美国东部 · {{hero.shortMeta}} · 4 场 NBA</text>
      </view>
      <text class="credit" wx:if="{{hero.credit}}">AI 示意图</text>
    </view>

    <view class="line">
      <view class="ln" wx:for="{{line}}" wx:key="key">
        <view class="ln-bar" wx:if="{{index > 0}}" style="background:{{item.color}}"></view>
        <view class="ln-stop" style="border-color:{{item.color}}"></view>
        <text class="ln-name">{{item.name}}</text>
        <text class="ln-md num">{{item.md}}</text>
      </view>
    </view>

    <view class="cta">进入行程</view>
  </view>

  <!-- 今天 / 出发前 -->
  <view class="now" wx:if="{{now}}">
    <view class="now-head">
      <view class="now-title">{{now.title}}</view>
      <view class="now-nav" wx:if="{{now.canNav}}" bindtap="navNow" hover-class="tap-dim">导航</view>
    </view>
    <view class="now-sub">{{now.sub}}</view>
    <view class="now-detail" wx:if="{{now.detail}}">{{now.detail}}</view>
  </view>

  <!-- 工具 -->
  <view class="section">随身工具</view>
  <view class="tools">
    <view
      class="tool"
      wx:for="{{tools}}"
      wx:key="key"
      data-url="{{item.url}}"
      bindtap="go"
      hover-class="tool-press"
    >
      <text class="tool-name">{{item.name}}</text>
      <text class="tool-sub">{{item.sub}}</text>
    </view>
  </view>

  <view class="foot">内容和 trip.byb521.com 同一份 · 景点照片来自维基共享资源，城市夜景为 AI 示意图</view>
</view>
