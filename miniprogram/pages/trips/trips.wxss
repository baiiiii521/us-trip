/* 首页：整页午夜蓝。一趟旅程是一张带五城线路的卡片 */
page {
  background: #0E1A3A;
}

.page {
  min-height: 100vh;
  padding-bottom: calc(56rpx + env(safe-area-inset-bottom));
  color: #F4F6FA;
}

.brand {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding-left: 32rpx;
  padding-right: 200rpx;
  height: 44px;
}

.mark {
  width: 56rpx;
  height: 56rpx;
  border-radius: 16rpx;
}

.mark-name {
  font-size: 30rpx;
  font-weight: 750;
}

.phase {
  font-size: 24rpx;
  font-weight: 700;
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.12);
  color: #A9B6D6;
}

.phase.now {
  background: #FFC233;
  color: #0E1A3A;
}

.lede {
  margin: 40rpx 32rpx 24rpx;
  font-size: 56rpx;
  font-weight: 800;
  letter-spacing: -0.02em;
}

/* 旅程卡 */
.trip-card {
  margin: 0 24rpx;
  border-radius: 32rpx;
  background: #17264D;
  overflow: hidden;
  box-shadow: 0 24rpx 48rpx -24rpx rgba(0, 0, 0, 0.6);
  transition: transform 160ms cubic-bezier(0.16, 1, 0.3, 1);
}

.card-press {
  transform: scale(0.985);
}

.cover {
  position: relative;
  height: 560rpx;
  background: #22335F;
}

.cover-img {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
}

.cover-fade {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 70%;
  background: linear-gradient(180deg, rgba(23, 38, 77, 0) 0%, rgba(23, 38, 77, 0.78) 58%, #17264D 100%);
}

.cover-text {
  position: absolute;
  left: 32rpx;
  right: 32rpx;
  bottom: 22rpx;
  display: flex;
  flex-direction: column;
}

.cover-kicker {
  font-size: 24rpx;
  font-weight: 700;
  color: #FFC233;
}

.cover-title {
  margin-top: 6rpx;
  font-size: 58rpx;
  line-height: 1.12;
  font-weight: 800;
  letter-spacing: -0.02em;
  color: #FFFFFF;
}

.cover-meta {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #C9D3EA;
}

.credit {
  position: absolute;
  right: 20rpx;
  top: 18rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.82);
  padding: 4rpx 12rpx;
  border-radius: 999rpx;
  background: rgba(14, 26, 58, 0.45);
}

/* 五城线路 */
.line {
  display: flex;
  padding: 22rpx 20rpx 8rpx;
}

.ln {
  flex: 1;
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.ln-bar {
  position: absolute;
  top: 13rpx;
  right: 50%;
  width: 100%;
  height: 8rpx;
  border-radius: 4rpx;
}

.ln-stop {
  position: relative;
  z-index: 1;
  width: 34rpx;
  height: 34rpx;
  border-radius: 50%;
  background: #FFFFFF;
  border: 8rpx solid;
  box-sizing: border-box;
}

.ln-name {
  margin-top: 12rpx;
  font-size: 24rpx;
  font-weight: 650;
  color: #FFFFFF;
}

.ln-md {
  margin-top: 2rpx;
  font-size: 24rpx;
  color: #A9B6D6;
}

.cta {
  margin: 26rpx 28rpx 30rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 96rpx;
  border-radius: 999rpx;
  background: #FFC233;
  color: #0E1A3A;
  font-size: 31rpx;
  font-weight: 750;
}

/* 今天 */
.now {
  margin: 24rpx 24rpx 0;
  padding: 28rpx 30rpx;
  border-radius: 28rpx;
  background: #FFFFFF;
  color: #0E1A3A;
}

.now-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.now-label {
  font-size: 24rpx;
  font-weight: 700;
  color: #6F7B96;
}

.now-nav {
  min-height: 60rpx;
  padding: 0 26rpx;
  display: flex;
  align-items: center;
  border-radius: 999rpx;
  background: #FFC233;
  font-size: 25rpx;
  font-weight: 700;
}

.now-title {
  font-size: 40rpx;
  font-weight: 800;
}

.now-sub {
  margin-top: 4rpx;
  font-size: 25rpx;
  color: #3D4A68;
}

.now-detail {
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid rgba(14, 26, 58, 0.1);
  font-size: 26rpx;
  line-height: 1.6;
  color: #3D4A68;
  display: -webkit-box;
  -webkit-line-clamp: 3;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

/* 工具：两列格子 */
.section {
  margin: 48rpx 32rpx 18rpx;
  font-size: 28rpx;
  font-weight: 750;
  color: #A9B6D6;
}

.tools {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
  margin: 0 24rpx;
}

.tool {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  padding: 26rpx 26rpx 28rpx;
  border-radius: 24rpx;
  background: #17264D;
  min-height: 120rpx;
}

.tool-press {
  background: #22335F;
}

.tool-name {
  font-size: 30rpx;
  font-weight: 700;
  color: #FFFFFF;
}

.tool-sub {
  font-size: 24rpx;
  line-height: 1.45;
  color: #A9B6D6;
}

.foot {
  margin: 40rpx 32rpx 0;
  font-size: 24rpx;
  line-height: 1.6;
  color: #A9B6D6;
}
