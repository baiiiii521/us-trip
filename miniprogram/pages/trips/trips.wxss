page {
  background: #EFF1F4;
}

.page {
  padding-bottom: 60rpx;
}

/* ── 封面 ───────────────────────────────── */
.hero {
  position: relative;
  min-height: 960rpx;
  background: #16202B;
  overflow: hidden;
  display: flex;
  flex-direction: column;
}

.hero-img {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  animation: kenburns 24s ease-out both;
}

@keyframes kenburns {
  from { transform: scale(1.02); }
  to { transform: scale(1.12); }
}

/* 从下往上的暗部，保证白字永远读得清 */
.hero-fade {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background:
    linear-gradient(180deg, rgba(10, 15, 20, 0.58) 0%, rgba(10, 15, 20, 0.06) 24%, rgba(10, 15, 20, 0.28) 50%, rgba(8, 12, 16, 0.97) 100%);
}

.hero-top {
  position: relative;
  display: flex;
  align-items: center;
  gap: 14rpx;
  padding: 16rpx 36rpx 0;
  /* 右边整块留给微信胶囊，任何东西都不许放进去 */
  padding-right: 210rpx;
}

.mark {
  width: 52rpx;
  height: 52rpx;
  border-radius: 16rpx;
}

.mark-name {
  font-size: 24rpx;
  font-weight: 600;
  color: rgba(255, 255, 255, 0.92);
  letter-spacing: 0.04em;
}

.phase {
  margin-left: 18rpx;
  font-size: 21rpx;
  font-weight: 600;
  color: rgba(255, 255, 255, 0.94);
  background: rgba(255, 255, 255, 0.16);
  border: 1rpx solid rgba(255, 255, 255, 0.22);
  backdrop-filter: blur(12px);
  border-radius: 999rpx;
  padding: 7rpx 16rpx;
  letter-spacing: 0.02em;
}

.phase.later {
  color: rgba(255, 255, 255, 0.78);
  background: rgba(255, 255, 255, 0.1);
}

.hero-body {
  position: relative;
  margin-top: auto;
  padding: 0 40rpx calc(76rpx + env(safe-area-inset-bottom));
  animation: rise 520ms cubic-bezier(0.16, 1, 0.3, 1) both;
}

@keyframes rise {
  from { opacity: 0; transform: translateY(26rpx); }
  to { opacity: 1; transform: translateY(0); }
}

.hero-title {
  font-size: 66rpx;
  line-height: 1.14;
  font-weight: 800;
  color: #FFFFFF;
  letter-spacing: -0.03em;
}

.hero-meta {
  margin-top: 16rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.82);
  letter-spacing: 0.01em;
  font-variant-numeric: tabular-nums;
}

.cta {
  margin-top: 34rpx;
  display: inline-flex;
  align-items: center;
  gap: 14rpx;
  /* 玻璃质感：压在照片上，不和下面那张白卡抢注意力 */
  background: rgba(255, 255, 255, 0.16);
  border: 1rpx solid rgba(255, 255, 255, 0.3);
  backdrop-filter: blur(14px);
  color: #FFFFFF;
  border-radius: 999rpx;
  padding: 22rpx 36rpx;
  align-self: flex-start;
}

.cta-press {
  opacity: 0.86;
  transform: scale(0.985);
}

.cta-text {
  font-size: 28rpx;
  font-weight: 700;
  letter-spacing: 0.01em;
}

.cta-arrow {
  font-size: 28rpx;
  color: #FFC08A;
}

.credit {
  position: absolute;
  right: 20rpx;
  bottom: 12rpx;
  font-size: 17rpx;
  color: rgba(255, 255, 255, 0.38);
}

/* ── 今天 ───────────────────────────────── */
.now {
  position: relative;
  margin: -76rpx 28rpx 0;
  background: #FFFFFF;
  border-radius: 30rpx;
  padding: 30rpx 30rpx 28rpx;
  box-shadow: 0 18rpx 50rpx rgba(16, 24, 32, 0.14);
  animation: rise 620ms cubic-bezier(0.16, 1, 0.3, 1) both;
}

.now-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.now-label {
  font-size: 21rpx;
  font-weight: 700;
  letter-spacing: 0.14em;
  color: #C04A0A;
}

.now-nav {
  font-size: 22rpx;
  color: #1F4E8C;
}

.now-title {
  margin-top: 10rpx;
  font-size: 40rpx;
  font-weight: 700;
  letter-spacing: -0.02em;
  line-height: 1.25;
}

.now-sub {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #33404C;
  line-height: 1.5;
}

.now-sub.dim {
  color: #5E6A76;
}

.now-detail {
  margin-top: 14rpx;
  padding-top: 14rpx;
  border-top: 1rpx solid rgba(22, 32, 43, 0.07);
  font-size: 22rpx;
  color: #33404C;
  line-height: 1.6;
}

/* ── 分组列表 ───────────────────────────── */
.section {
  margin: 40rpx 40rpx 12rpx;
  font-size: 21rpx;
  font-weight: 600;
  letter-spacing: 0.12em;
  color: #8A94A0;
}

.card {
  margin: 0 28rpx;
  background: #FFFFFF;
  border-radius: 28rpx;
  box-shadow: 0 2rpx 10rpx rgba(16, 24, 32, 0.05);
}

.group {
  padding: 4rpx 30rpx;
}

.row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 26rpx 0;
  border-bottom: 1rpx solid rgba(22, 32, 43, 0.06);
}

.row:last-child {
  border-bottom: none;
}

.row-press {
  opacity: 0.6;
}

.row-l {
  flex: 1;
  min-width: 0;
}

.row-name {
  font-size: 30rpx;
  font-weight: 500;
  color: #16202B;
  letter-spacing: -0.01em;
}

.row-sub {
  display: block;
  margin-top: 4rpx;
  font-size: 22rpx;
  color: #939DA9;
}

.row-chev {
  font-size: 32rpx;
  color: #C3CAD2;
  line-height: 1;
}

/* ── 所有旅程 ───────────────────────────── */
.trip {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 26rpx 30rpx;
  margin-bottom: 14rpx;
}

.trip-l {
  flex: 1;
  min-width: 0;
}

.trip-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #16202B;
}

.trip-meta {
  display: block;
  margin-top: 4rpx;
  font-size: 22rpx;
  color: #939DA9;
  font-variant-numeric: tabular-nums;
}

.trip-trail {
  display: block;
  margin-top: 6rpx;
  font-size: 21rpx;
  color: #A3ADB8;
}

.trip-chev {
  font-size: 32rpx;
  color: #C3CAD2;
}

.foot {
  margin-top: 34rpx;
  text-align: center;
  font-size: 21rpx;
  color: #A3ADB8;
}
