.head {
  padding: 16rpx 0 32rpx;
}

.head .title {
  margin: 8rpx 0 8rpx;
}

.trip {
  padding: 0;
  overflow: hidden;
}

/* 封面块：暂时用主题色的暗块，日后换成实拍照片 */
.trip-cover {
  height: 200rpx;
  background: #16202B;
  padding: 24rpx 28rpx;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
}

.trip-cover-en {
  color: rgba(255, 255, 255, 0.92);
  font-size: 34rpx;
  font-weight: 700;
  letter-spacing: 0.08em;
}

.trip-cover-line {
  width: 56rpx;
  height: 6rpx;
  background: #C04A0A;
  margin-top: 14rpx;
  border-radius: 3rpx;
}

.trip-body {
  padding: 28rpx;
}

.trip-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.trip-title {
  font-size: 38rpx;
  font-weight: 700;
  color: #16202B;
}

.trip-meta {
  display: flex;
  align-items: center;
  margin-top: 10rpx;
  font-size: 26rpx;
  color: #5E6A76;
}

.trip-meta .dot {
  margin: 0 10rpx;
}

.trip-trail {
  margin-top: 20rpx;
  display: flex;
  flex-wrap: wrap;
  align-items: center;
}

.trail-city {
  font-size: 26rpx;
  color: #33404C;
  background: #EEF1F4;
  border-radius: 8rpx;
  padding: 6rpx 14rpx;
  margin: 6rpx 0;
}

.trail-arrow {
  font-size: 24rpx;
  color: #A3ADB8;
  margin: 0 10rpx;
}

.trip-summary {
  margin-top: 20rpx;
  font-size: 28rpx;
  color: #33404C;
  line-height: 1.55;
}

.trip-foot {
  margin-top: 24rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid rgba(22, 32, 43, 0.1);
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.trip-open {
  font-size: 28rpx;
  font-weight: 600;
  color: #C04A0A;
}

.trip-chev {
  font-size: 34rpx;
  color: #C04A0A;
}

.foot-note {
  margin-top: 8rpx;
  text-align: center;
  font-size: 24rpx;
  color: #A3ADB8;
}
