page {
  background: var(--ink);
}

.wrap {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  padding: 24rpx 32rpx calc(32rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.tabs {
  display: flex;
  gap: 12rpx;
}

.tab {
  flex: 1;
  text-align: center;
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.78);
  padding: 14rpx 0;
  border-radius: 14rpx;
  background: rgba(255, 255, 255, 0.07);
}

.tab.on {
  color: var(--ink);
  background: #FFFFFF;
}

.stage {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  padding: 24rpx 0;
}

.big {
  color: #FFFFFF;
  font-size: 60rpx;
  line-height: 1.28;
  font-weight: 700;
  text-align: center;
  word-break: break-word;
}

.small {
  margin-top: 20rpx;
  color: rgba(255, 255, 255, 0.78);
  font-size: 28rpx;
  text-align: center;
}

.bar {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.nav-btn {
  width: 96rpx;
  height: 88rpx;
  line-height: 84rpx;
  text-align: center;
  border-radius: 16rpx;
  background: rgba(255, 255, 255, 0.1);
  color: #FFFFFF;
  font-size: 40rpx;
}

.dots {
  flex: 1;
  text-align: center;
  color: rgba(255, 255, 255, 0.78);
  font-size: 24rpx;
}

.copy {
  width: 120rpx;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  border-radius: 16rpx;
  background: var(--night);
  color: #FFFFFF;
  font-size: 28rpx;
}

.hint {
  margin-top: 18rpx;
  text-align: center;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.78);
}
