.lead {
  font-size: 24rpx;
  color: var(--muted);
  line-height: 1.6;
  padding: 8rpx 4rpx 20rpx;
}

.group-head {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin: 30rpx 0 14rpx;
  font-size: 28rpx;
  font-weight: 750;
  color: var(--ink);
}

/* 和其它页的区块标题一样：前面一小段线路 */
.group-head::before {
  content: '';
  flex: none;
  width: 34rpx;
  height: 8rpx;
  border-radius: 4rpx;
  background: var(--night);
}

.slot {
  padding: 20rpx 22rpx;
}

.slot-top {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 12rpx;
}

.slot-l {
  flex: 1;
  min-width: 0;
}

.slot-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--ink);
  line-height: 1.4;
}

.slot-hint {
  display: block;
  font-size: 24rpx;
  color: var(--muted);
  margin-top: 4rpx;
  line-height: 1.4;
}

.slot-md {
  flex: none;
  font-size: 24rpx;
  color: var(--ink);
}

.slot-val {
  margin-top: 12rpx;
  background: var(--ground);
  border-radius: 12rpx;
  padding: 14rpx 16rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.v {
  font-size: 28rpx;
  font-family: ui-monospace, Menlo, monospace;
  color: var(--ink);
  letter-spacing: 0.02em;
}

.copy {
  font-size: 24rpx;
  color: var(--muted);
}

.slot-empty {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: var(--muted);
  border: 1rpx dashed rgba(14, 26, 58, 0.2);
  border-radius: 12rpx;
  padding: 16rpx;
  text-align: center;
}

.slot-foot {
  margin-top: 12rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.slot-shots {
  font-size: 24rpx;
  color: var(--muted);
}

.slot-edit {
  font-size: 24rpx;
  color: var(--ink);
}

.foot-note {
  font-size: 24rpx;
  color: var(--muted);
  text-align: center;
  padding: 16rpx 0 40rpx;
}

/* 弹层 */
.mask {
  position: fixed;
  inset: 0;
  background: rgba(14, 26, 58, 0.45);
  z-index: 90;
}

.sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 91;
  background: #FFFFFF;
  border-radius: 28rpx 28rpx 0 0;
  padding: 32rpx 32rpx calc(32rpx + env(safe-area-inset-bottom));
  max-height: 86vh;
  overflow-y: auto;
}

.sheet-title {
  font-size: 34rpx;
  font-weight: 700;
}

.sheet-hint {
  font-size: 24rpx;
  color: var(--muted);
  margin-top: 6rpx;
  line-height: 1.5;
}

.field {
  margin-top: 22rpx;
}

.field-label {
  font-size: 24rpx;
  color: var(--muted);
}

.field-input {
  margin-top: 8rpx;
  height: 84rpx;
  background: var(--ground);
  border-radius: 14rpx;
  padding: 0 20rpx;
  font-size: 28rpx;
}

.shot-row {
  margin-top: 22rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.shot-btn {
  flex: none;
  min-width: 200rpx;
  min-height: 76rpx;
  font-size: 28rpx;
}

.shot-count {
  font-size: 24rpx;
  color: var(--muted);
}

.shots {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  margin-top: 16rpx;
}

.shot {
  position: relative;
  width: 150rpx;
  height: 150rpx;
}

.shot-img {
  width: 150rpx;
  height: 150rpx;
  border-radius: 12rpx;
  background: var(--ground);
}

.shot-del {
  position: absolute;
  right: -8rpx;
  top: -8rpx;
  width: 40rpx;
  height: 40rpx;
  line-height: 36rpx;
  text-align: center;
  border-radius: 28rpx;
  background: rgba(14, 26, 58, 0.78);
  color: #FFFFFF;
  font-size: 28rpx;
}

.sheet-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 28rpx;
}

.half {
  flex: 1;
}
