.search {
  padding: 4rpx 0 16rpx;
}

.search-input {
  height: 76rpx;
  background: #FFFFFF;
  border: 1rpx solid rgba(22, 32, 43, 0.12);
  border-radius: 16rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
}

.filters {
  width: 100%;
  white-space: nowrap;
  margin-bottom: 12rpx;
}

.filters-inner {
  display: inline-flex;
  gap: 12rpx;
}

.filter {
  flex: none;
  padding: 10rpx 22rpx;
  border-radius: 20rpx;
  background: #FFFFFF;
  border: 1rpx solid rgba(22, 32, 43, 0.12);
  font-size: 26rpx;
  color: #33404C;
}

.filter.on {
  background: #16202B;
  border-color: #16202B;
  color: #FFFFFF;
}

.count {
  font-size: 22rpx;
  color: #5E6A76;
  padding: 4rpx 4rpx 16rpx;
}

.poi-card {
  padding: 0;
  display: flex;
  gap: 0;
  overflow: hidden;
}

.poi-hover {
  opacity: 0.92;
}

.poi-thumb {
  width: 200rpx;
  height: 200rpx;
  flex: none;
  background: #EEF1F4;
}

.poi-fallback {
  width: 200rpx;
  height: 200rpx;
  flex: none;
  padding: 16rpx;
  display: flex;
  align-items: flex-end;
}

.poi-fallback-t {
  color: rgba(255, 255, 255, 0.92);
  font-size: 21rpx;
  line-height: 1.3;
}

.poi-info {
  flex: 1;
  padding: 18rpx 20rpx;
  min-width: 0;
}

.poi-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 8rpx;
}

.poi-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #16202B;
}

.poi-cat {
  font-size: 21rpx;
  color: #5E6A76;
}

.poi-en {
  font-size: 22rpx;
  color: #A3ADB8;
  margin-top: 2rpx;
}

.poi-tag {
  margin-top: 8rpx;
  font-size: 26rpx;
  color: #33404C;
  line-height: 1.5;
}

.poi-days {
  margin-top: 10rpx;
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 8rpx;
}

.poi-day {
  font-size: 21rpx;
  color: #C04A0A;
  background: rgba(192, 74, 10, 0.08);
  border-radius: 6rpx;
  padding: 2rpx 8rpx;
}

.poi-day-note {
  font-size: 21rpx;
  color: #A3ADB8;
}

.empty {
  text-align: center;
  font-size: 26rpx;
  color: #5E6A76;
  padding: 60rpx 0;
}
