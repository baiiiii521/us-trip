/* 顶栏下面接一段午夜蓝：搜索框和城市筛选都在这条带子里 */
.band {
  background: var(--night);
  padding: 4rpx 0 24rpx;
  margin-bottom: 20rpx;
}

.search {
  padding: 0 24rpx 18rpx;
}

.search-input {
  height: 80rpx;
  background: var(--night-2);
  border-radius: 999rpx;
  padding: 0 32rpx;
  font-size: 28rpx;
  color: #FFFFFF;
}

.filters {
  width: 100%;
  white-space: nowrap;
}

.filters-inner {
  display: inline-flex;
  gap: 12rpx;
  padding: 0 24rpx;
}

.filter {
  flex: none;
  display: inline-flex;
  align-items: center;
  gap: 10rpx;
  min-height: 64rpx;
  padding: 0 26rpx;
  border-radius: 999rpx;
  background: var(--night-2);
  font-size: 26rpx;
  font-weight: 600;
  color: var(--on-night-2);
}

.filter.on {
  background: #FFFFFF;
  color: var(--ink);
}

.fdot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
}

.count {
  margin: 0 32rpx 16rpx;
  font-size: 24rpx;
  color: var(--muted);
}

.poi-card {
  margin: 0 24rpx 18rpx;
  padding: 0;
  display: flex;
  overflow: hidden;
}

.poi-hover {
  transform: scale(0.99);
  opacity: 0.94;
}

.poi-thumb,
.poi-fallback {
  width: 216rpx;
  min-height: 216rpx;
  flex: none;
  background: var(--ground);
}

.poi-fallback {
  padding: 18rpx;
  display: flex;
  align-items: flex-end;
  box-sizing: border-box;
}

.poi-fallback-t {
  color: #FFFFFF;
  font-size: 24rpx;
  font-weight: 700;
  line-height: 1.3;
}

.poi-info {
  flex: 1;
  min-width: 0;
  padding: 22rpx 24rpx;
}

.poi-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 12rpx;
}

.poi-name {
  font-size: 30rpx;
  line-height: 1.35;
  font-weight: 750;
  color: var(--ink);
}

.poi-cat {
  flex: none;
  font-size: 24rpx;
  color: var(--muted);
}

.poi-en {
  margin-top: 2rpx;
  font-size: 24rpx;
  color: var(--muted);
}

.poi-tag {
  display: block;
  margin-top: 10rpx;
  font-size: 25rpx;
  line-height: 1.5;
  color: var(--ink-2);
}

.poi-days {
  margin-top: 14rpx;
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 10rpx;
}

/* 这个地方排在行程哪几天：前面一个城市色站点 */
.pdot {
  width: 22rpx;
  height: 22rpx;
  border-radius: 50%;
  border: 6rpx solid;
  box-sizing: border-box;
  background: #FFFFFF;
}

.poi-day {
  font-size: 24rpx;
  font-weight: 650;
  color: var(--ink);
  font-variant-numeric: tabular-nums;
}

.empty {
  text-align: center;
  padding: 60rpx 32rpx;
}
