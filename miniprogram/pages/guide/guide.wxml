<view class="page with-nav">
  <top-bar show-back title="景点图鉴" sub="68 个地方 · 按城市筛" />
  <view class="search">
    <input
      class="search-input"
      placeholder="搜景点（中文或英文）"
      value="{{q}}"
      bindinput="search"
      confirm-type="search"
    />
  </view>

  <scroll-view class="filters" scroll-x="{{true}}" enhanced="{{true}}" show-scrollbar="{{false}}">
    <view class="filters-inner">
      <view hover-class="press" hover-stay-time="60"
        wx:for="{{cities}}"
        wx:key="key"
        class="filter {{active === item.key ? 'on' : ''}}"
        data-key="{{item.key}}"
        bindtap="pick"
      >{{item.label}}</view>
    </view>
  </scroll-view>

  <view class="count" wx:if="{{q || active !== 'all'}}">{{total}} 个地方<span wx:if="{{q}}"> · 搜「{{q}}」</span></view>

  <view class="empty" wx:if="{{!list.length}}">
    <view class="empty-title">没找到「{{q}}」</view>
    <view class="empty-sub">换中文名试试，或者点上面的城市看全部</view>
  </view>

  <view class="card poi-card" wx:for="{{list}}" wx:key="id" data-id="{{item.id}}" bindtap="open" hover-class="poi-hover">
    <image
      wx:if="{{item.photo}}"
      class="poi-thumb"
      src="{{item.photo}}"
      mode="aspectFill"
      lazy-load="{{true}}"
    />
    <view class="poi-fallback" wx:else style="background:{{item.color}}">
      <text class="poi-fallback-t">{{item.name}}</text>
    </view>
    <view class="poi-info">
      <view class="poi-head">
        <text class="poi-name">{{item.name}}</text>
        <text class="poi-cat">{{item.cat}}</text>
      </view>
      <view class="poi-en">{{item.en}}</view>
      <view class="poi-tag">{{item.tag}}</view>
      <view class="poi-days" wx:if="{{item.days.length}}">
        <text class="poi-day" wx:for="{{item.days}}" wx:key="*this" wx:for-item="d">{{d}}</text>
        <text class="poi-day" wx:if="{{item.moreDays}}">+{{item.moreDays}}</text>
      </view>
    </view>
  </view>

  <view class="empty" wx:if="{{!list.length}}">没找到，换个词试试。</view>
</view>

<bottom-nav current="guide" tripId="{{tripId}}" />
