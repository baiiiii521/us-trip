.plan {
  font-size: 32rpx;
  font-weight: 750;
  line-height: 1.4;
  color: var(--ink);
  padding-bottom: 18rpx;
  margin-bottom: 8rpx;
  border-bottom: 1rpx solid var(--line);
}

/* 取车 → 还车：一条线两站，绿是出发的波士顿线、琥珀是终点纽约线 */
.run-st {
  display: flex;
  gap: 18rpx;
}

.run-rail {
  position: relative;
  flex: none;
  width: 40rpx;
  display: flex;
  justify-content: center;
}

.run-line {
  position: absolute;
  left: 16rpx;
  top: 0;
  bottom: 0;
  width: 8rpx;
  background: linear-gradient(180deg, #2FB36B, #FFC233);
}

.run-line.first {
  top: 20rpx;
}

.run-line.last {
  bottom: auto;
  height: 20rpx;
  background: #FFC233;
}

.run-dot {
  position: relative;
  z-index: 1;
  margin-top: 6rpx;
  width: 34rpx;
  height: 34rpx;
  border-radius: 50%;
  border: 9rpx solid;
  background: #FFFFFF;
  box-sizing: border-box;
}

.run-body {
  flex: 1;
  min-width: 0;
  padding-bottom: 34rpx;
}

.run-head {
  font-size: 26rpx;
  font-weight: 700;
  color: var(--muted);
  margin-bottom: 6rpx;
}

.kv {
  display: flex;
  gap: 18rpx;
  padding: 9rpx 0;
}

.k {
  flex: none;
  width: 90rpx;
  font-size: 24rpx;
  color: var(--muted);
}

.val {
  flex: 1;
  font-size: 24rpx;
  color: var(--ink);
  line-height: 1.5;
}

.strong {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--ink);
  line-height: 1.45;
}

.mt {
  margin-top: 14rpx;
}

.warn {
  font-size: 24rpx;
  color: var(--warn);
  background: rgba(138, 90, 11, 0.08);
  border-radius: 12rpx;
  padding: 14rpx;
  line-height: 1.55;
}

.note {
  font-size: 24rpx;
  color: var(--muted);
  line-height: 1.55;
  margin-top: 8rpx;
}

.drive {
  padding: 20rpx 22rpx;
}

.drive-top {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 12rpx;
}

.drive-name {
  font-size: 28rpx;
  font-weight: 600;
}

.drive-mi {
  font-size: 24rpx;
  color: var(--ink);
}

.drive-h {
  font-size: 24rpx;
  color: var(--muted);
  margin-top: 4rpx;
}

.drive-route {
  font-size: 24rpx;
  color: var(--ink-2);
  line-height: 1.55;
  margin-top: 10rpx;
}

.drive-via {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #1F4FC4;
  background: rgba(31, 78, 140, 0.07);
  border-radius: 10rpx;
  padding: 10rpx 14rpx;
}

.drive-stops {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-top: 10rpx;
}

.rest {
  font-size: 24rpx;
  color: var(--ink-2);
  background: var(--ground);
  border-radius: 8rpx;
  padding: 6rpx 12rpx;
}

.drive-risk {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: var(--warn);
  line-height: 1.55;
}

.drive-toll {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: var(--muted);
  line-height: 1.5;
}

.guide-group {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--ink);
  margin-bottom: 8rpx;
}

.guide-item {
  font-size: 24rpx;
  color: var(--ink-2);
  line-height: 1.6;
  padding: 6rpx 0;
}
