<page-meta page-style="{{festive.style}}" />
<top-bar show-back title="小技巧" sub="入境 · 坐车 · 看球" />
<view class="page-pad">
  <view class="lead">网站「实用提示」整页搬过来的：{{groups.length}} 组、{{checklist.length}} 条待办，出发前按这个勾。</view>

  <view class="card group" wx:for="{{groups}}" wx:key="group" wx:for-item="g" wx:for-index="gi">
    <view hover-class="press" hover-stay-time="60" class="group-head" data-i="{{gi}}" bindtap="toggle">
      <view class="group-l">
        <text class="group-name">{{g.group}}</text>
        <text class="group-count">{{g.items.length}} 条</text>
      </view>
      <text class="group-arrow">{{openGroup === gi ? '收起' : '展开'}}</text>
    </view>
    <block wx:if="{{openGroup === gi}}">
      <view class="item" wx:for="{{g.items}}" wx:key="*this" wx:for-item="t">{{t}}</view>
      <view class="src" wx:if="{{g.src}}">来源：{{g.src}}</view>
    </block>
  </view>

  <view class="section-label">出发前清单</view>
  <view class="card">
    <view class="check" wx:for="{{checklist}}" wx:key="id">
      <text class="when">{{item.when}}</text>
      <text class="check-text">{{item.text}}</text>
    </view>
  </view>

  <view class="section-label">资料来源</view>
  <view class="card">
    <view class="source" wx:for="{{sources}}" wx:key="*this" wx:for-item="s">
      <text class="source-name">{{s[0]}}</text>
      <text hover-class="press" hover-stay-time="60" class="source-url" data-url="{{s[1]}}" bindtap="copyLink" catchtap="copyLink">{{s[1]}}</text>
    </view>
  </view>

  <view class="foot-note">内容和 trip.byb521.com 同源；官网时间、价格有变以官方为准。</view>
</view>
