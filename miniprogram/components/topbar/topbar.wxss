/* 顶部栏：半透明材质，内容从下面滚过去；底下不是硬分割线，是一道很轻的渐隐 */
.bar {
  position: sticky;
  top: 0;
  z-index: 40;
  background: rgba(242, 243, 245, 0.86);
  backdrop-filter: blur(22px) saturate(180%);
  -webkit-backdrop-filter: blur(22px) saturate(180%);
}

.bar::after {
  content: '';
  position: absolute;
  left: 0;
  right: 0;
  bottom: -14rpx;
  height: 14rpx;
  background: linear-gradient(180deg, rgba(16, 24, 32, 0.07), rgba(16, 24, 32, 0));
  pointer-events: none;
}

.bar.ghost {
  background: transparent;
  backdrop-filter: none;
  -webkit-backdrop-filter: none;
}

.bar.ghost::after {
  display: none;
}

.inner {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 0 32rpx;
  /* 右边整块给微信胶囊 */
  padding-right: 200rpx;
  box-sizing: border-box;
}

.back {
  width: 60rpx;
  height: 60rpx;
  border-radius: 30rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-left: -10rpx;
  background: rgba(17, 23, 30, 0.06);
}

.back-hover {
  background: rgba(17, 23, 30, 0.14);
  transform: scale(0.94);
}

.chev {
  font-size: 40rpx;
  line-height: 1;
  color: #11171E;
  margin-top: -4rpx;
}

.logo {
  width: 58rpx;
  height: 58rpx;
  border-radius: 18rpx;
  flex: none;
}

.texts {
  flex: 1;
  min-width: 0;
}

/* 大标题负字距，小字正字距——同一页里不同字号各用各的 */
.title {
  font-size: 36rpx;
  font-weight: 700;
  color: #11171E;
  letter-spacing: -0.02em;
  line-height: 1.18;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.sub {
  font-size: 21rpx;
  color: #5E6A76;
  letter-spacing: 0.01em;
  margin-top: 3rpx;
  line-height: 1.25;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.badge {
  flex: none;
  margin-left: auto;
  font-size: 20rpx;
  font-weight: 600;
  color: #C04A0A;
  background: rgba(192, 74, 10, 0.09);
  border-radius: 999rpx;
  padding: 8rpx 16rpx;
  font-variant-numeric: tabular-nums;
  letter-spacing: 0.02em;
}

/* 底部 3rpx 进度：这一趟走完多少 */
.rail {
  height: 3rpx;
  background: rgba(17, 23, 30, 0.06);
  overflow: hidden;
}

.rail-fill {
  height: 100%;
  background: #C04A0A;
  transition: width 620ms cubic-bezier(0.16, 1, 0.3, 1);
}
