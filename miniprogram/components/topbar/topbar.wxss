.bar {
  position: sticky;
  top: 0;
  z-index: 40;
  background: rgba(243, 245, 247, 0.92);
  backdrop-filter: blur(16px);
  border-bottom: 1rpx solid rgba(22, 32, 43, 0.06);
}

.bar.ghost {
  background: transparent;
  border-bottom: none;
  backdrop-filter: none;
}

.inner {
  height: 92rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 0 32rpx;
  /* 右边给微信胶囊让位 */
  padding-right: 190rpx;
  box-sizing: border-box;
}

.back {
  width: 60rpx;
  height: 60rpx;
  border-radius: 30rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-left: -12rpx;
  background: rgba(22, 32, 43, 0.05);
}

.back-hover {
  background: rgba(22, 32, 43, 0.12);
}

.chev {
  font-size: 40rpx;
  line-height: 1;
  color: #16202B;
  margin-top: -4rpx;
}

.logo {
  width: 60rpx;
  height: 60rpx;
  border-radius: 16rpx;
  flex: none;
}

.texts {
  min-width: 0;
}

.title {
  font-size: 34rpx;
  font-weight: 700;
  color: #16202B;
  letter-spacing: 0.01em;
  line-height: 1.2;
}

.sub {
  font-size: 21rpx;
  color: #5E6A76;
  margin-top: 2rpx;
  line-height: 1.2;
}
