.bar {
  position: sticky;
  top: 0;
  z-index: 40;
  background: #F3F5F7;
  border-bottom: 1rpx solid rgba(22, 32, 43, 0.07);
}

.bar.ghost {
  background: transparent;
  border-bottom: none;
}

.inner {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 0 32rpx;
  /* 右边给微信胶囊让位 */
  padding-right: 200rpx;
  box-sizing: border-box;
}

.back {
  width: 60rpx;
  height: 60rpx;
  border-radius: 30rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-left: -10rpx;
  background: rgba(22, 32, 43, 0.06);
}

.back-hover {
  background: rgba(22, 32, 43, 0.14);
}

.chev {
  font-size: 40rpx;
  line-height: 1;
  color: #16202B;
  margin-top: -4rpx;
}

.logo {
  width: 58rpx;
  height: 58rpx;
  border-radius: 18rpx;
  flex: none;
}

.texts {
  flex: 1;
  min-width: 0;
}

.title {
  font-size: 36rpx;
  font-weight: 700;
  color: #16202B;
  letter-spacing: -0.015em;
  line-height: 1.18;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.sub {
  font-size: 21rpx;
  color: #5E6A76;
  margin-top: 3rpx;
  line-height: 1.25;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 右上角进度徽标：有信息才出现，不做装饰 */
.badge {
  flex: none;
  margin-left: auto;
  font-size: 20rpx;
  font-weight: 600;
  color: #C04A0A;
  background: rgba(192, 74, 10, 0.09);
  border-radius: 999rpx;
  padding: 8rpx 16rpx;
  font-variant-numeric: tabular-nums;
  letter-spacing: 0.01em;
}

/* 底部 3rpx 进度条：这一趟走完多少 */
.rail {
  height: 3rpx;
  background: rgba(22, 32, 43, 0.07);
  overflow: hidden;
}

.rail-fill {
  height: 100%;
  background: #C04A0A;
  transition: width 620ms cubic-bezier(0.16, 1, 0.3, 1);
}
