/* 顶部栏：午夜蓝搪瓷，白字；底边是整趟旅程的五色线 */
.bar {
  padding-bottom: 12rpx;
  position: sticky;
  top: 0;
  z-index: 40;
  background: var(--night, #0E1A3A);
  color: #F4F6FA;
}

.bar.ghost {
  background: transparent;
}

.inner {
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 0 32rpx;
  /* 右边整块给微信胶囊 */
  padding-right: 200rpx;
  box-sizing: border-box;
}

.back {
  flex: none;
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-left: -12rpx;
  background: rgba(255, 255, 255, 0.1);
}

.back-hover {
  background: rgba(255, 255, 255, 0.22);
  transform: scale(0.94);
}

/* 返回箭头：两条边画出来的，不用字符 */
.back-chev {
  width: 18rpx;
  height: 18rpx;
  margin-left: 6rpx;
  border-left: 5rpx solid #F4F6FA;
  border-bottom: 5rpx solid #F4F6FA;
  border-radius: 2rpx;
  transform: rotate(45deg);
}

.logo {
  width: 58rpx;
  height: 58rpx;
  border-radius: 16rpx;
  flex: none;
}

.texts {
  flex: 1;
  min-width: 0;
}

.title {
  font-size: 36rpx;
  font-weight: 750;
  color: #F4F6FA;
  line-height: 1.18;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.sub {
  font-size: 24rpx;
  color: var(--on-night-2, #A9B6D6);
  margin-top: 4rpx;
  line-height: 1.25;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 第几天：琥珀小站牌 */
.badge {
  flex: none;
  margin-left: auto;
  font-size: 24rpx;
  font-weight: 700;
  color: #0E1A3A;
  background: var(--go, #FFC233);
  border-radius: 999rpx;
  padding: 8rpx 18rpx;
}

.rail {
  display: flex;
  gap: 4rpx;
  height: 8rpx;
  padding: 4rpx 32rpx 6rpx;
}

.seg {
  height: 8rpx;
  border-radius: 4rpx;
  transition: opacity 620ms cubic-bezier(0.16, 1, 0.3, 1);
}

/* 节日彩灯：一根细线挂一排小灯泡，轮流亮 */
.bulbs {
  position: relative;
  height: 30rpx;
  margin: -4rpx 24rpx 6rpx;
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
}

.wire {
  position: absolute;
  left: 0;
  right: 0;
  top: 6rpx;
  height: 2rpx;
  background: rgba(255, 255, 255, 0.35);
}

.bulb {
  position: relative;
  margin-top: 6rpx;
  width: 14rpx;
  height: 20rpx;
  border-radius: 50% 50% 50% 50% / 40% 40% 60% 60%;
  animation: twinkle 1200ms ease-in-out infinite;
}

@keyframes twinkle {
  0%, 100% { opacity: 1; box-shadow: 0 4rpx 14rpx rgba(255, 220, 140, 0.7); }
  50% { opacity: 0.45; box-shadow: none; }
}
