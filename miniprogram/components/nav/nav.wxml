<view class="nav">
  <view
    wx:for="{{items}}"
    wx:key="key"
    class="item {{item.key === current ? 'on' : ''}}"
    data-key="{{item.key}}"
    data-url="{{item.url}}"
    bindtap="go"
    hover-class="item-hover"
  >
    <image class="ic" src="{{item.key === current ? item.on : item.icon}}" mode="aspectFit" />
    <text class="label">{{item.label}}</text>
  </view>
</view>
