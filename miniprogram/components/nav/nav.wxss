.nav {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: stretch;
  background: rgba(255, 255, 255, 0.94);
  backdrop-filter: blur(20px);
  border-top: 1rpx solid rgba(22, 32, 43, 0.07);
  padding-bottom: env(safe-area-inset-bottom);
  z-index: 50;
}

.item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding-top: 14rpx;
  padding-bottom: 12rpx;
  gap: 6rpx;
}

.item-hover {
  background: rgba(22, 32, 43, 0.03);
}

.ic {
  width: 46rpx;
  height: 46rpx;
}

.label {
  font-size: 21rpx;
  color: #8A94A0;
  letter-spacing: 0.02em;
}

.item.on .label {
  color: #C04A0A;
  font-weight: 600;
}
