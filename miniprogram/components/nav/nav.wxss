/* 底部导航：白底，选中的那一格上面亮一小段琥珀线，像站台上亮着的那一站 */
.nav {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: stretch;
  background: rgba(255, 255, 255, 0.94);
  backdrop-filter: blur(24px) saturate(180%);
  -webkit-backdrop-filter: blur(24px) saturate(180%);
  box-shadow: 0 -1rpx 0 rgba(14, 26, 58, 0.08), 0 -12rpx 28rpx -20rpx rgba(14, 26, 58, 0.3);
  padding-bottom: env(safe-area-inset-bottom);
  z-index: 50;
}

.item {
  position: relative;
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding-top: 18rpx;
  padding-bottom: 12rpx;
  gap: 6rpx;
  min-height: 104rpx;
  box-sizing: border-box;
}

.item.on::before {
  content: '';
  position: absolute;
  top: 0;
  left: 50%;
  width: 56rpx;
  height: 8rpx;
  margin-left: -28rpx;
  border-radius: 0 0 6rpx 6rpx;
  background: #FFC233;
}

.item-hover {
  opacity: 0.55;
}

.ic {
  width: 48rpx;
  height: 48rpx;
}

.label {
  font-size: 24rpx;
  color: #6F7B96;
}

.item.on .label {
  color: #0E1A3A;
  font-weight: 700;
}
