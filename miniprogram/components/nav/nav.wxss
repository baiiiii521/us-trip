.nav {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  background: #FFFFFF;
  border-top: 1rpx solid rgba(22, 32, 43, 0.12);
  padding-bottom: env(safe-area-inset-bottom);
  z-index: 50;
}

.nav-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 104rpx;
}

.nav-dot {
  width: 8rpx;
  height: 8rpx;
  border-radius: 4rpx;
  background: transparent;
  margin-bottom: 8rpx;
}

.nav-label {
  font-size: 24rpx;
  color: #5E6A76;
}

.nav-item.on .nav-label {
  color: #16202B;
  font-weight: 600;
}

.nav-item.on .nav-dot {
  background: #C04A0A;
}
