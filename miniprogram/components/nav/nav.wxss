/* 底部导航：同样是材质层，内容从下面滚过；按下立刻反馈 */
.nav {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: stretch;
  background: rgba(255, 255, 255, 0.82);
  backdrop-filter: blur(24px) saturate(180%);
  -webkit-backdrop-filter: blur(24px) saturate(180%);
  padding-bottom: env(safe-area-inset-bottom);
  z-index: 50;
}

/* 上沿一道渐隐，不用 1px 硬线 */
.nav::before {
  content: '';
  position: absolute;
  left: 0;
  right: 0;
  top: -14rpx;
  height: 14rpx;
  background: linear-gradient(0deg, rgba(16, 24, 32, 0.06), rgba(16, 24, 32, 0));
  pointer-events: none;
}

.item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding-top: 14rpx;
  padding-bottom: 12rpx;
  gap: 6rpx;
  transition: opacity 120ms cubic-bezier(0.16, 1, 0.3, 1);
}

.item-hover {
  opacity: 0.55;
}

.ic {
  width: 46rpx;
  height: 46rpx;
  transition: transform 160ms cubic-bezier(0.16, 1, 0.3, 1);
}

.label {
  font-size: 21rpx;
  color: #8A94A0;
  letter-spacing: 0.02em;
}

.item.on .label {
  color: #C04A0A;
  font-weight: 600;
}

.item.on .ic {
  transform: translateY(-1rpx);
}
