/* 全局样式：沿用网站的 tokens.css（中性色 + 唯一强调色篮球橙 #C04A0A）。
   WXSS 里不依赖 CSS 变量（部分安卓内核会丢），颜色直接写字面值。
   规则：正文 32rpx（16px）、标签 26rpx 起、间距按 8rpx（4px）的倍数。 */
page {
  background: #F3F5F7;
  color: #16202B;
  font-size: 32rpx;
  line-height: 1.6;
  font-family: -apple-system, "PingFang SC", "Helvetica Neue", "Microsoft YaHei", sans-serif;
  -webkit-font-smoothing: antialiased;
}

/* 有底部导航的页面，内容要给导航条留出位置（含 iPhone 安全区） */
.with-nav {
  padding-bottom: calc(160rpx + env(safe-area-inset-bottom));
}

.page-pad {
  padding: 32rpx 32rpx 64rpx;
}

/* 卡片：白底 + 1px 冷灰细边，不用阴影堆层次 */
.card {
  background: #FFFFFF;
  border: 1rpx solid rgba(22, 32, 43, 0.12);
  border-radius: 24rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
}

.card-tap {
  transition: transform 160ms ease, border-color 160ms ease;
}

.card-tap:active {
  transform: scale(0.985);
  border-color: rgba(22, 32, 43, 0.28);
}

.eyebrow {
  font-size: 24rpx;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  color: #5E6A76;
}

.title {
  font-size: 44rpx;
  line-height: 1.25;
  font-weight: 700;
  letter-spacing: -0.01em;
}

.subtitle {
  font-size: 26rpx;
  color: #5E6A76;
}

.body-text {
  font-size: 30rpx;
  color: #33404C;
}

.muted {
  color: #5E6A76;
}

.accent {
  color: #C04A0A;
}

.hairline {
  height: 1rpx;
  background: rgba(22, 32, 43, 0.1);
  margin: 24rpx 0;
}

/* 主按钮只有一种：橙底白字，最小 88rpx 高（44px）好点 */
.btn-primary {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 88rpx;
  padding: 0 32rpx;
  border-radius: 20rpx;
  background: #C04A0A;
  color: #FFFFFF;
  font-size: 30rpx;
  font-weight: 600;
}

.btn-primary:active {
  opacity: 0.88;
}

.btn-ghost {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 88rpx;
  padding: 0 32rpx;
  border-radius: 20rpx;
  border: 1rpx solid rgba(22, 32, 43, 0.24);
  color: #16202B;
  font-size: 30rpx;
}

.pill {
  display: inline-flex;
  align-items: center;
  height: 44rpx;
  padding: 0 18rpx;
  border-radius: 22rpx;
  font-size: 24rpx;
  background: #EEF1F4;
  color: #33404C;
}

.pill-accent {
  background: rgba(192, 74, 10, 0.1);
  color: #C04A0A;
}

/* 全局：按下反馈 + 数字等宽（时间、金额、里程对齐才不会跳） */
.tap-dim {
  opacity: 0.65;
}

.num,
.tnum {
  font-variant-numeric: tabular-nums;
}
