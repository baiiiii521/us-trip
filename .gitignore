node_modules/
dist/
.DS_Store
*.log

# 视频渲染产物（可用 video/tools/capture.cjs 重新生成）
video/out/
/data/

# 本地截图（用 Playwright/浏览器在 390×844 下检查用，不进仓库）
.shots/

# 小程序上传产物（预览二维码、错误日志，随时可重出）
.mp-out/

# 个人信息（护照号、PNR、房号），只在本机
private/*
!private/itinerary.example.json
# 底图原始数据（npm pack us-atlas@3 取得）
scripts/data/

# 3D 行程片的渲染产物和工具缓存（源码在 video/intro3d/index.html，用 om render 重新生成）
video/intro3d/out/
video/intro3d/tools/
video/intro3d/.om/
video/intro3d/assets/sound.wav
video/intro3d/assets/gen/codex.log

# 地理编码缓存（结果已生成到 miniprogram/shared/data/*.js，缓存本身不用进仓库）
.cache/

# 本机 agent 运行时目录
.omh/
